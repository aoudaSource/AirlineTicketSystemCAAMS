@page
@model CAAMSAirlineWebApp.Pages.Admin.Reports.DailyRevenueModel
@{
    ViewData["Title"] = "Daily Revenue";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2>Daily Revenue</h2>
    <span class="text-muted small">Last 24 hours as of @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
</div>
<a asp-page="/Admin/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Dashboard</a>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div class="small">Total Revenue (24h)</div>
                <div class="fs-4 fw-bold">MYR @Model.TotalRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="small">Tickets Sold (24h)</div>
                <div class="fs-4 fw-bold">@Model.TotalTickets</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="small">Peak Hour</div>
                <div class="fs-4 fw-bold">
                    @if (Model.TotalRevenue > 0)
                    {
                        <span>@Model.PeakHour:00 (MYR @Model.PeakRevenue.ToString("N0"))</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Revenue by Hour (MYR)</div>
    <div class="card-body">
        <canvas id="revenueChart" height="100"></canvas>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Tickets Sold by Hour</div>
    <div class="card-body">
        <canvas id="ticketChart" height="80"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(Model.HourLabelsJson);
        const revenueData = @Html.Raw(Model.RevenueDataJson);
        const ticketData = @Html.Raw(Model.TicketCountDataJson);

        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Revenue (MYR)',
                    data: revenueData,
                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                    borderColor: 'rgba(13, 110, 253, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: v => 'MYR ' + v.toLocaleString()
                        }
                    }
                }
            }
        });

        new Chart(document.getElementById('ticketChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Tickets Sold',
                    data: ticketData,
                    backgroundColor: 'rgba(25, 135, 84, 0.7)',
                    borderColor: 'rgba(25, 135, 84, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}
