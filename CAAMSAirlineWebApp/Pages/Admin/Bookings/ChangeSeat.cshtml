@page
@model CAAMSAirlineWebApp.Pages.Admin.Bookings.ChangeSeatModel
@{
    ViewData["Title"] = "Change Seat";
}

<style>
    /* Premium Branding Typography */
    .seat-header, .form-label, .btn-airline-confirm {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
        font-weight: 700;
    }

    .geologica-text {
        font-family: 'Geologica', sans-serif;
    }

    /* Info Card Styling */
    .seat-card {
        border: none;
        border-radius: 12px;
        background-color: #ffffff;
    }

    .summary-box {
        background-color: #f8faff;
        border-radius: 8px;
        padding: 20px;
        border-left: 4px solid #0c206d;
    }

    /* Seat Badge Styling */
    .current-seat-badge {
        background-color: #0c206d !important;
        color: white !important;
        letter-spacing: 1px;
        padding: 6px 12px;
    }

    .class-badge {
        background-color: #eef1f7;
        color: #0c206d;
        border: 1px solid #0c206d;
        font-weight: 600;
        font-size: 0.75rem;
    }

    /* Primary Action Button */
    .btn-airline-confirm {
        background-color: #0c206d !important;
        border-color: #0c206d !important;
        color: white !important;
        padding: 10px 25px;
        transition: 0.3s;
    }

        .btn-airline-confirm:hover:not(:disabled) {
            background-color: #08164d !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    /* Custom Back Link */
    .airline-back-link {
        color: #0c206d;
        text-decoration: none;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
    }

        .airline-back-link:hover {
            text-decoration: underline;
        }

    .seat-container {
        padding-bottom: 120px;
    }
</style>

<div class="container seat-container mt-5">
    <h2 class="seat-header text-uppercase mb-1">
        <i class="bi bi-grid-3x3-gap-fill me-2"></i>Reassign Seat
    </h2>
    <a asp-page="/Admin/Bookings/Details"
       asp-route-bookingId="@Model.BookingId"
       class="airline-back-link small mb-4 d-inline-block">&larr; Return to Booking #@Model.BookingId</a>

    <div class="card seat-card shadow-sm" style="max-width:550px;">
        <div class="card-body p-4">

            <div class="summary-box mb-4 shadow-sm">
                <dl class="row mb-0 geologica-text align-items-center">
                    <dt class="col-sm-4 text-muted small text-uppercase">Passenger</dt>
                    <dd class="col-sm-8 fw-bold mb-3" style="color:#0c206d;">@Model.PassengerName</dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Flight</dt>
                    <dd class="col-sm-8 mb-3">
                        <i class="bi bi-airplane-fill me-1 text-primary"></i> @Model.FlightInfo
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Cabin Class</dt>
                    <dd class="col-sm-8 mb-3">
                        <span class="badge class-badge">@Model.TicketClass</span>
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Current Seat</dt>
                    <dd class="col-sm-8 mb-0">
                        <span class="badge current-seat-badge font-monospace fs-6 shadow-sm">@Model.CurrentSeat</span>
                    </dd>
                </dl>
            </div>

            <form method="post">
                <input type="hidden" asp-for="HiddenTicketId" />
                <input type="hidden" asp-for="HiddenBookingId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 geologica-text small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="SelectedSeatId" class="form-label">
                        Available @Model.TicketClass Seats
                    </label>

                    @if (!Model.AvailableSeats.Any())
                    {
                        <div class="alert alert-warning border-0 bg-light-warning py-3 geologica-text small">
                            <i class="bi bi-exclamation-octagon-fill me-2 text-warning"></i>
                            The @Model.TicketClass cabin is currently at full capacity for this flight.
                        </div>
                    }
                    else
                    {
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-plus-circle text-primary"></i></span>
                            <select asp-for="SelectedSeatId" asp-items="Model.AvailableSeats"
                                    class="form-select font-monospace fw-bold">
                                <option value="">-- Choose New Assignment --</option>
                            </select>
                        </div>
                        <div class="form-text small mt-2">
                            <i class="bi bi-info-circle me-1"></i> @Model.AvailableSeats.Count() unassigned seats found.
                        </div>
                    }
                </div>

                <div class="mt-5 d-flex gap-3">
                    <button type="submit" class="btn btn-airline-confirm shadow-sm px-4"
                            @(!Model.AvailableSeats.Any() ? "disabled" : "")>
                        Update Seat Assignment
                    </button>
                    <a asp-page="/Admin/Bookings/Details"
                       asp-route-bookingId="@Model.BookingId"
                       class="btn btn-outline-secondary geologica-text px-4" style="padding-top:10px;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}