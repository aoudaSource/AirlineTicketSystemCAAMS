@page
@model CAAMSAirlineWebApp.Pages.BookingFormModel
@{
    ViewData["Title"] = "Passenger Details";
}

<h2 class="mb-4">Passenger Details</h2>

@* ── FLIGHT SUMMARY ── *@
<div class="card mb-4 shadow-sm border-primary">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-2">
                <span class="fw-bold fs-5">@Model.FlightNumber</span>
            </div>
            <div class="col-md-5 text-center">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div>
                        <div class="fs-5 fw-bold">@Model.DepartureCode</div>
                        <div class="text-muted small">@Model.DepartureCity</div>
                        <div class="fw-semibold">@Model.DepartureTime.ToString("hh:mm tt")</div>
                    </div>
                    <div class="text-center text-muted px-2">
                        <div>────✈────</div>
                        <div class="small">@Model.DepartureTime.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div>
                        <div class="fs-5 fw-bold">@Model.ArrivalCode</div>
                        <div class="text-muted small">@Model.ArrivalCity</div>
                        <div class="fw-semibold">@Model.ArrivalTime.ToString("hh:mm tt")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2 text-center">
                <div class="text-muted small">Base Price</div>
                <div class="fw-bold fs-5">$@Model.BasePrice.ToString("F2")</div>
            </div>
            <div class="col-md-3 text-end">
                <span class="badge bg-primary">@Model.Input.TicketClass</span>
            </div>
        </div>
    </div>
</div>

@* ── BOOKING FORM ── *@
<form method="post" novalidate>
    <input type="hidden" asp-for="Input.FlightId" />
    <input type="hidden" asp-for="Input.PassengerCount" />

    <input type="hidden" asp-for="Input.TicketClass" />

    <hr />

    @for (int i = 0; i < Model.Input.PassengerCount; i++)
    {
        <h5 class="mt-3">Passenger @(i + 1)</h5>
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">First Name</label>
                <input asp-for="Input.Passengers[i].FirstName" class="form-control" />
                <span asp-validation-for="Input.Passengers[i].FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Last Name</label>
                <input asp-for="Input.Passengers[i].LastName" class="form-control" />
                <span asp-validation-for="Input.Passengers[i].LastName" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Passport Number</label>
                <input asp-for="Input.Passengers[i].PassportNumber" class="form-control" />
                <span asp-validation-for="Input.Passengers[i].PassportNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Date of Birth</label>
                <input asp-for="Input.Passengers[i].DOB" type="date" class="form-control dob-input" />
                <span asp-validation-for="Input.Passengers[i].DOB" class="text-danger small"></span>
                <span class="text-danger small minor-age-warning" style="display:none;">
                    Passengers aged 14 or under must be accompanied by an adult and cannot book independently.
                </span>
            </div>
        </div>
    }

    <hr />

    @if (Model.EstimatedTotal > 0)
    {
        <p class="fs-5 mb-3">Estimated Total: <strong class="text-success">$@Model.EstimatedTotal.ToString("F2")</strong></p>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg">Confirm Booking</button>
        <a asp-page="/BookFlight" class="btn btn-outline-secondary btn-lg">Back to Search</a>
    </div>
</form>

@section Scripts {
    <script>
        // Minor age warning — only show if no adult exists among all passengers
        function calcAge(dob) {
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
            return age;
        }

        function updateMinorWarnings() {
            const inputs = Array.from(document.querySelectorAll('.dob-input'));
            const ages = inputs.map(i => i.value ? calcAge(new Date(i.value)) : null);
            const hasAdult = ages.some(a => a !== null && a > 14);

            inputs.forEach(function (input, idx) {
                const warning = input.closest('.col-md-3').querySelector('.minor-age-warning');
                const age = ages[idx];
                warning.style.display = (age !== null && age >= 2 && age <= 14 && !hasAdult) ? '' : 'none';
            });
        }

        document.querySelectorAll('.dob-input').forEach(function (input) {
            input.addEventListener('change', updateMinorWarnings);
        });
    </script>
}
