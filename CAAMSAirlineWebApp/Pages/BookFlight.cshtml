@page
@model CAAMSAirlineWebApp.Pages.BookFlightModel
@{
    ViewData["Title"] = "Book a Flight";
}

<style>
    .booking-header, .form-label, .btn-airline-search, .flight-number {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
    }

    .geologica-text {
        font-family: 'Geologica', sans-serif;
    }

    .search-card {
        border-radius: 15px;
        background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%);
        border: 1px solid #eef1f7;
    }

    .form-control:focus, .form-select:focus {
        border-color: #3c81bd;
        box-shadow: 0 0 0 0.25rem rgba(60,129,189,0.15);
    }

    .btn-airline-search {
        background-color: #0c206d !important;
        border-color: #0c206d !important;
        color: white !important;
        font-weight: 600;
        padding: 12px;
        transition: 0.3s;
    }

        .btn-airline-search:hover {
            background-color: #08164d !important;
            transform: translateY(-2px);
        }

    .flight-card {
        border-radius: 12px;
        transition: 0.3s ease;
        border: 1px solid transparent;
    }

        .flight-card:hover {
            border-color: #3c81bd;
            transform: scale(1.01);
            box-shadow: 0 10px 20px rgba(12,32,109,0.08) !important;
        }

        .flight-card.selected-outbound {
            border-color: #3c81bd;
            background: #f0f7ff;
        }

    .airport-code {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0c206d;
        line-height: 1;
    }

    .flight-path {
        position: relative;
        color: #cbd5e0;
        font-size: 1.2rem;
    }

    .price-tag {
        color: #0c206d;
        font-size: 1.4rem;
        font-weight: 800;
    }

    .btn-book-now {
        background-color: #0c206d;
        color: white;
        border-radius: 50px;
        font-weight: 600;
        padding: 8px 25px;
        transition: 0.3s;
        border: none;
        cursor: pointer;
    }

        .btn-book-now:hover {
            background-color: #3c81bd;
            color: white;
        }

        .btn-book-now.selected {
            background-color: #3c81bd;
        }

    .search-title {
        border-left: 5px solid #0c206d;
        padding-left: 15px;
        font-weight: 800;
    }

    .section-divider {
        border: none;
        border-top: 2px solid #3c81bd;
        margin: 30px 0 20px;
        opacity: 0.3;
    }

    .return-locked {
        opacity: 0.4;
        pointer-events: none;
    }

    /* Scrollable flight box */
    .flights-scroll-box {
        max-height: 560px;
        overflow-y: auto;
        padding-right: 6px;
        scrollbar-width: thin;
        scrollbar-color: #3c81bd #f0f4f8;
        border: 1px solid #eef1f7;
        border-radius: 12px;
        padding: 12px;
        background: #fafcff;
    }

        .flights-scroll-box::-webkit-scrollbar {
            width: 6px;
        }

        .flights-scroll-box::-webkit-scrollbar-track {
            background: #f0f4f8;
            border-radius: 10px;
        }

        .flights-scroll-box::-webkit-scrollbar-thumb {
            background: #3c81bd;
            border-radius: 10px;
        }

    /* Autocomplete */
    .autocomplete-wrapper {
        position: relative;
        flex: 1;
    }

    .autocomplete-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #dce6f0;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(12,32,109,0.1);
        z-index: 9999;
        max-height: 200px;
        overflow-y: auto;
        display: none;
    }

    .autocomplete-item {
        padding: 8px 14px;
        cursor: pointer;
        font-family: 'Geologica', sans-serif;
        font-size: 0.85rem;
        color: #1a3a5c;
        border-bottom: 1px solid #f0f4f8;
    }

        .autocomplete-item:last-child {
            border-bottom: none;
        }

        .autocomplete-item:hover {
            background: #f0f7ff;
        }

        .autocomplete-item .code {
            font-weight: 700;
            color: #3c81bd;
            margin-right: 6px;
        }

        .autocomplete-item .country {
            font-size: 0.75rem;
            color: #999;
            margin-left: 4px;
        }
</style>

<div class="container mt-5 pb-5">
    <h2 class="booking-header text-uppercase search-title mb-4">Find Your Next Destination</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show geologica-text" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* SEARCH FORM *@
    @if (Model.PageStep == "search" || Model.PageStep == "results")
    {
        <div class="card search-card p-4 mb-5 shadow-sm">
            <form method="get" novalidate id="searchForm">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-uppercase">Departure City</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-geo-alt text-primary"></i></span>
                            <div class="autocomplete-wrapper">
                                <input asp-for="Search.Origin" id="originInput"
                                       class="form-control border-start-0 geologica-text"
                                       placeholder="e.g. KUL or Kuala Lumpur"
                                       autocomplete="off"
                                       oninput="showSuggestions('originInput', 'originDropdown')"
                                       onblur="hideSuggestions('originDropdown')" />
                                <div class="autocomplete-dropdown" id="originDropdown"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-uppercase">Arrival City</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-airplane-engines text-primary"></i></span>
                            <div class="autocomplete-wrapper">
                                <input asp-for="Search.Destination" id="destInput"
                                       class="form-control border-start-0 geologica-text"
                                       placeholder="e.g. SIN or Singapore"
                                       autocomplete="off"
                                       oninput="showSuggestions('destInput', 'destDropdown')"
                                       onblur="hideSuggestions('destDropdown')" />
                                <div class="autocomplete-dropdown" id="destDropdown"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-uppercase">Trip Type</label>
                        <select asp-for="Search.TripType" class="form-select geologica-text" id="tripTypeSelect">
                            <option value="OneWay">One-Way</option>
                            <option value="RoundTrip">Round Trip</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-uppercase">Departure Date</label>
                        <input asp-for="Search.DepartureDate" type="date" class="form-control geologica-text" id="departureDateInput"
                               oninput="filterByDate('outbound-cards', this.value)" />
                    </div>
                    <div class="col-md-2" id="returnDateGroup" style="display:none;">
                        <label class="form-label fw-bold small text-uppercase">Return Date</label>
                        <input asp-for="Search.ReturnDate" type="date" class="form-control geologica-text" id="returnDateInput"
                               oninput="filterByDate('return-cards', this.value)" />
                    </div>
                </div>
                <div class="row g-3 mt-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-uppercase">Travelers</label>
                        <select asp-for="Search.PassengerCount" class="form-select geologica-text">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <option value="@i">@i Traveler@(i > 1 ? "s" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-airline-search w-100 shadow-sm">
                            <i class="bi bi-search me-2"></i>Search Flights
                        </button>
                    </div>
                </div>
            </form>
        </div>
    }

    @* RESULTS *@
    @if (Model.PageStep == "results")
    {
        var isRoundTrip = Model.Search.TripType == "RoundTrip";

        @* OUTBOUND *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="geologica-text fw-bold mb-0">
                @if (isRoundTrip)
                {
                    <span>Outbound — </span>
                }
                <span class="text-primary">@Model.SearchResults.Count</span> flights
            </h5>
            <span class="text-muted small">Scroll to see more</span>
        </div>

        @if (!Model.SearchResults.Any())
        {
            <div class="alert alert-light border shadow-sm p-4 text-center geologica-text">
                <i class="bi bi-cloud-slash display-4 text-muted mb-3 d-block"></i>
                <h4>No Flights Found</h4>
                <p class="text-muted">Try a different route.</p>
            </div>
        }
        else
        {
            <div class="flights-scroll-box">
                <div id="outbound-cards">
                    @foreach (var flight in Model.SearchResults)
                    {
                        <div class="card flight-card mb-3 shadow-sm outbound-item"
                             data-date="@flight.DepartureTime.ToString("yyyy-MM-dd")">
                            <div class="card-body p-4">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <div class="text-muted small text-uppercase fw-bold">Flight</div>
                                        <span class="flight-number fs-4 fw-800">@flight.FlightNumber</span>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="d-flex align-items-center justify-content-between px-3">
                                            <div class="text-center">
                                                <div class="airport-code">@flight.DepartureCode</div>
                                                <div class="text-muted small fw-bold">@flight.DepartureCity</div>
                                                <div class="fw-bold text-primary mt-1">@flight.DepartureTime.ToString("HH:mm")</div>
                                            </div>
                                            <div class="flex-grow-1 mx-4 text-center">
                                                <div class="small text-muted mb-1">Non-stop</div>
                                                <div class="flight-path">
                                                    <hr class="m-0" style="border-top: 2px dashed #cbd5e0;">
                                                    <i class="bi bi-airplane-fill position-absolute top-50 start-50 translate-middle bg-white px-2 text-primary"></i>
                                                </div>
                                                <div class="small text-muted mt-1">@flight.DepartureTime.ToString("ddd, MMM dd")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="airport-code">@flight.ArrivalCode</div>
                                                <div class="text-muted small fw-bold">@flight.ArrivalCity</div>
                                                <div class="fw-bold text-primary mt-1">@flight.ArrivalTime.ToString("HH:mm")</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 text-center border-start border-end">
                                        <div class="text-muted small text-uppercase fw-bold">Best Price</div>
                                        <div class="price-tag"><small class="fs-6 fw-normal">MYR</small> @flight.BasePrice.ToString("N2")</div>
                                        <div class="text-success small"><i class="bi bi-lightning-charge-fill"></i> Instant Booking</div>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        @if (isRoundTrip)
                                        {
                                            <button class="btn-book-now px-4 py-2"
                                                    onclick="selectOutbound('@flight.FlightId', '@flight.DepartureTime.ToString("yyyy-MM-dd")', this)">
                                                Select
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-book-now px-4 py-2"
                                                    onclick="selectOneWay('@flight.FlightId', '@flight.DepartureTime.ToString("yyyy-MM-dd")', @Model.Search.PassengerCount)">
                                                Select
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* RETURN *@
        @if (isRoundTrip && Model.ReturnResults.Any())
        {
            <hr class="section-divider" />
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="geologica-text fw-bold mb-0">
                    Return — <span class="text-primary">@Model.ReturnResults.Count</span> flights
                </h5>
                <span class="text-muted small" id="returnHint">Select an outbound flight first</span>
            </div>

            <div class="flights-scroll-box">
                <div id="return-cards" class="return-locked">
                    @foreach (var flight in Model.ReturnResults)
                    {
                        <div class="card flight-card mb-3 shadow-sm return-item"
                             data-date="@flight.DepartureTime.ToString("yyyy-MM-dd")">
                            <div class="card-body p-4">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <div class="text-muted small text-uppercase fw-bold">Flight</div>
                                        <span class="flight-number fs-4 fw-800">@flight.FlightNumber</span>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="d-flex align-items-center justify-content-between px-3">
                                            <div class="text-center">
                                                <div class="airport-code">@flight.DepartureCode</div>
                                                <div class="text-muted small fw-bold">@flight.DepartureCity</div>
                                                <div class="fw-bold text-primary mt-1">@flight.DepartureTime.ToString("HH:mm")</div>
                                            </div>
                                            <div class="flex-grow-1 mx-4 text-center">
                                                <div class="small text-muted mb-1">Non-stop</div>
                                                <div class="flight-path">
                                                    <hr class="m-0" style="border-top: 2px dashed #cbd5e0;">
                                                    <i class="bi bi-airplane-fill position-absolute top-50 start-50 translate-middle bg-white px-2 text-primary"></i>
                                                </div>
                                                <div class="small text-muted mt-1">@flight.DepartureTime.ToString("ddd, MMM dd")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="airport-code">@flight.ArrivalCode</div>
                                                <div class="text-muted small fw-bold">@flight.ArrivalCity</div>
                                                <div class="fw-bold text-primary mt-1">@flight.ArrivalTime.ToString("HH:mm")</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 text-center border-start border-end">
                                        <div class="text-muted small text-uppercase fw-bold">Best Price</div>
                                        <div class="price-tag"><small class="fs-6 fw-normal">MYR</small> @flight.BasePrice.ToString("N2")</div>
                                        <div class="text-success small"><i class="bi bi-lightning-charge-fill"></i> Instant Booking</div>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <button class="btn-book-now px-4 py-2"
                                                onclick="selectReturn('@flight.FlightId', '@flight.DepartureTime.ToString("yyyy-MM-dd")', @Model.Search.PassengerCount)">
                                            Select
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        // Airport data from server
        const airports = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                    Model.Airports.Select(a => new
                                    {
                                                code = a.AirportCode,
                                                city = a.City,
                                                name = a.AirportName,
                                                country = a.Country
                                    })
                    ));

        // Show autocomplete suggestions
        function showSuggestions(inputId, dropdownId) {
            const input = document.getElementById(inputId);
            const dropdown = document.getElementById(dropdownId);
            const val = input.value.trim().toLowerCase();

            if (val.length < 1) { dropdown.style.display = 'none'; return; }

            const matches = airports.filter(a =>
                a.code.toLowerCase().includes(val) ||
                a.city.toLowerCase().includes(val) ||
                a.name.toLowerCase().includes(val) ||
                a.country.toLowerCase().includes(val)
            ).slice(0, 6);

            if (matches.length === 0) { dropdown.style.display = 'none'; return; }

            dropdown.innerHTML = matches.map(a => `
                <div class="autocomplete-item" onmousedown="selectSuggestion('${inputId}', '${dropdownId}', '${a.code}')">
                    <span class="code">${a.code}</span>
                    ${a.city}
                    <span class="country">${a.country}</span>
                </div>
            `).join('');

            dropdown.style.display = 'block';
        }

        // Select a suggestion
        function selectSuggestion(inputId, dropdownId, code) {
            document.getElementById(inputId).value = code;
            document.getElementById(dropdownId).style.display = 'none';
        }

        // Hide dropdown on blur (small delay so click registers first)
        function hideSuggestions(dropdownId) {
            setTimeout(() => {
                const dropdown = document.getElementById(dropdownId);
                if (dropdown) dropdown.style.display = 'none';
            }, 150);
        }

        // Trip type toggle
        const tripTypeSelect = document.getElementById('tripTypeSelect');
        const returnDateGroup = document.getElementById('returnDateGroup');
        function toggleReturnDate() {
            if (tripTypeSelect && returnDateGroup)
                returnDateGroup.style.display = tripTypeSelect.value === 'RoundTrip' ? '' : 'none';
        }
        if (tripTypeSelect) { tripTypeSelect.addEventListener('change', toggleReturnDate); toggleReturnDate(); }

        // Live date filter
        function filterByDate(containerId, value) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const val = value.trim();
            container.querySelectorAll('.card').forEach(card => {
                const date = card.dataset.date || '';
                card.style.display = (!val || date.includes(val)) ? '' : 'none';
            });
        }

        // One-way
        function selectOneWay(flightId, date, passengerCount) {
            const dep = document.getElementById('departureDateInput');
            if (dep) dep.value = date;
            window.location.href = '/BookingForm?flightId=' + flightId + '&passengerCount=' + passengerCount;
        }

        // Round trip step 1
        var selectedOutboundId = null;
        function selectOutbound(flightId, date, btn) {
            selectedOutboundId = flightId;
            const dep = document.getElementById('departureDateInput');
            if (dep) dep.value = date;
            document.querySelectorAll('.outbound-item').forEach(c => c.classList.remove('selected-outbound'));
            btn.closest('.card').classList.add('selected-outbound');
            btn.textContent = 'Selected';
            btn.classList.add('selected');
            const returnSection = document.getElementById('return-cards');
            if (returnSection) returnSection.classList.remove('return-locked');
            const hint = document.getElementById('returnHint');
            if (hint) hint.textContent = 'Now select your return flight';
            const divider = document.querySelector('.section-divider');
            if (divider) divider.scrollIntoView({ behavior: 'smooth' });
        }

        // Round trip step 2
        function selectReturn(returnFlightId, date, passengerCount) {
            if (!selectedOutboundId) { alert('Please select an outbound flight first.'); return; }
            const ret = document.getElementById('returnDateInput');
            if (ret) ret.value = date;
            window.location.href = '/BookingForm?flightId=' + selectedOutboundId + '&returnFlightId=' + returnFlightId + '&passengerCount=' + passengerCount;
        }
    </script>
}
