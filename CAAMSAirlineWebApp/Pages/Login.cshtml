@page
@model CAAMSAirlineWebApp.Pages.LoginModel
@{
    ViewData["Title"] = "Log In";
}

<style>
    .btn-airline {
        background-color: #0c206d !important;
        border-color: #0c206d !important;
        color: white !important;
        font-family: 'Geologica', sans-serif;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-airline:hover {
            background-color: #08164d !important;
            transform: translateY(-2px);
        }

    .login-title {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
        font-weight: 800;
    }

    .airline-link {
        color: #0c206d;
        font-weight: bold;
        text-decoration: none;
    }

        .airline-link:hover {
            text-decoration: underline;
        }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h1 class="login-title">@ViewData["Title"]</h1>
            <p>
                Don't have an account?
                <a asp-page="/Register" class="airline-link">Create one here</a>.
            </p>
            <hr />

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post" novalidate>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Username" class="form-control" placeholder="Username" />
                    <label asp-for="Input.Username">Username</label>
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" type="password" placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-airline">Log In</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
