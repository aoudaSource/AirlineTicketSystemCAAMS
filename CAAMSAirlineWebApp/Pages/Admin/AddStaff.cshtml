@page
@model CAAMSAirlineWebApp.Pages.Admin.AddStaffModel
@{
    ViewData["Title"] = "Add New Staff";
}

<style>
    .admin-header {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
        text-transform: uppercase;
        font-weight: 700;
    }

    .card-admin {
        border: 2px solid #0c206d;
        border-radius: 12px;
        background-color: #0c206d;
        color: white;
    }

    .form-label {
        font-weight: 600;
        color: #ffffff;
    }

    .btn-save {
        background-color: #ffffff;
        color: #0c206d;
        font-weight: 700;
        border: none;
    }
</style>

@* Added pb-5 and mb-5 for plenty of space at the bottom *@
<div class="container mt-5 pb-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="admin-header mb-4 text-center">Register New Staff Member</h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning">@Model.ErrorMessage</div>
            }

            <div class="card card-admin shadow-lg mb-5">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <input asp-for="Input.FirstName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <input asp-for="Input.LastName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Username</label>
                                <input asp-for="Input.Username" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Permanent Password</label>
                                <input asp-for="Input.Password" type="password" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Date of Birth</label>
                                <input asp-for="Input.DOB" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="mt-5">
                            <button type="submit" class="btn btn-save w-100 py-3">Create Staff Account</button>
                            <div class="text-center mt-3">
                                <a asp-page="/Admin/Index" class="text-white-50 text-decoration-none small">Cancel and Return</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>