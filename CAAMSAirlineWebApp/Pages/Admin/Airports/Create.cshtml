@page
@model CAAMSAirlineWebApp.Pages.Admin.Airports.CreateModel
@{
    ViewData["Title"] = "Add Airport";
}

<h2 class="mb-1">Add Airport</h2>
<a asp-page="/Admin/Airports/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Airports</a>

<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">

                <div class="col-sm-4">
                    <label asp-for="Input.AirportCode" class="form-label"></label>
                    <input asp-for="Input.AirportCode" class="form-control text-uppercase font-monospace"
                           placeholder="e.g. KUL" maxlength="3" />
                    <span asp-validation-for="Input.AirportCode" class="text-danger small"></span>
                </div>

                <div class="col-sm-8">
                    <label asp-for="Input.AirportName" class="form-label"></label>
                    <input asp-for="Input.AirportName" class="form-control"
                           placeholder="e.g. Kuala Lumpur International Airport" />
                    <span asp-validation-for="Input.AirportName" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.City" class="form-label"></label>
                    <input asp-for="Input.City" class="form-control" placeholder="e.g. Kuala Lumpur" />
                    <span asp-validation-for="Input.City" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.State" class="form-label">
                        State <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <input asp-for="Input.State" class="form-control" placeholder="e.g. Selangor" />
                    <span asp-validation-for="Input.State" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.Country" class="form-label"></label>
                    <input asp-for="Input.Country" class="form-control" placeholder="e.g. Malaysia" />
                    <span asp-validation-for="Input.Country" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Add Airport</button>
                <a asp-page="/Admin/Airports/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
