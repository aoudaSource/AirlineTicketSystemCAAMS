@page
@model CAAMSAirlineWebApp.Pages.Admin.Bookings.DetailsModel
@{
    ViewData["Title"] = $"Booking #{Model.Booking.BookingId}";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2>Booking #@Model.Booking.BookingId</h2>
    <span class="text-muted small">@Model.Booking.BookingDate.ToString("dd MMM yyyy HH:mm")</span>
</div>
<a asp-page="/Admin/Bookings/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Bookings</a>

<div class="card mb-4 shadow-sm">
    <div class="card-body d-flex gap-5">
        <div>
            <div class="text-muted small">Customer</div>
            <div class="fw-semibold">@Model.Booking.Customer.FirstName @Model.Booking.Customer.LastName</div>
        </div>
        <div>
            <div class="text-muted small">Total Paid</div>
            <div class="fw-semibold">MYR @Model.Booking.TotalPrice.ToString("N2")</div>
        </div>
        <div>
            <div class="text-muted small">Passengers</div>
            <div class="fw-semibold">@Model.Booking.Passengers.Count</div>
        </div>
    </div>
</div>

@foreach (var passenger in Model.Booking.Passengers)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">@passenger.FirstName @passenger.LastName</span>
            <a asp-page="/Admin/Bookings/EditPassenger"
               asp-route-passengerId="@passenger.PassengerId"
               asp-route-bookingId="@Model.Booking.BookingId"
               class="btn btn-sm btn-outline-warning">
                Edit Passport Info
            </a>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-sm-4">
                    <span class="text-muted small">Passport Number</span><br />
                    <span class="fw-semibold font-monospace">@passenger.PassportNumber</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small">Date of Birth</span><br />
                    <span>@passenger.DOB.ToString("dd MMM yyyy")</span>
                </div>
            </div>

            @if (passenger.Tickets.Any())
            {
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Flight</th>
                            <th>Route</th>
                            <th>Departure</th>
                            <th>Class</th>
                            <th>Seat</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in passenger.Tickets)
                        {
                            <tr>
                                <td>@ticket.FlightLeg.Flight.FlightNumber</td>
                                <td>
                                    @ticket.FlightLeg.DepartureAirport →
                                    @ticket.FlightLeg.ArrivalAirport
                                </td>
                                <td>@ticket.FlightLeg.DepartureTime.ToString("dd MMM HH:mm")</td>
                                <td>@ticket.TicketClass</td>
                                <td>
                                    @if (ticket.Seat != null)
                                    {
                                        <span class="badge bg-secondary font-monospace">@ticket.Seat.SeatNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    <a asp-page="/Admin/Bookings/ChangeSeat"
                                       asp-route-ticketId="@ticket.TicketId"
                                       asp-route-bookingId="@Model.Booking.BookingId"
                                       class="btn btn-sm btn-outline-primary">
                                        Change Seat
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
