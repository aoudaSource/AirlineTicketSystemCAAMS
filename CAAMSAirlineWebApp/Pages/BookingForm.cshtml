@page
@model CAAMSAirlineWebApp.Pages.BookingFormModel
@{
    ViewData["Title"] = "Complete Booking";
}

<style>
    .booking-header, .form-label, .btn-airline-confirm, .passenger-title {
        font-family: 'Geologica', sans-serif; color: #0c206d;
    }
    .geologica-text { font-family: 'Geologica', sans-serif; }
    .ticket-summary { border: none; border-left: 8px solid #0c206d; border-radius: 12px; background-color: #f8faff; }
    .passenger-section { background: white; border: 1px solid #eef1f7; border-radius: 12px; padding: 20px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
    .passenger-number { background: #0c206d; color: white; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.8rem; margin-right: 10px; }
    .price-checkout-box { background-color: #0c206d; color: white; border-radius: 12px; padding: 25px; }
    .minor-warning-box { background-color: #fff5f5; border: 1px solid #feb2b2; color: #c53030; padding: 10px; border-radius: 6px; font-size: 0.85rem; margin-top: 10px; }
    .btn-airline-confirm { background-color: #0c206d !important; border-color: #0c206d !important; color: white !important; font-weight: 600; transition: 0.3s; }
    .btn-airline-confirm:hover { background-color: #08164d !important; transform: translateY(-2px); }

    .seat-grid-container {
        background: #f8f9fa; padding: 20px; border-radius: 12px; margin: 20px 0;
        display: flex; flex-direction: column; align-items: center;
    }
    .seat-row { display: flex; gap: 10px; margin-bottom: 10px; }
    .seat {
        width: 40px; height: 40px; border-radius: 6px; border: 1px solid #ccc;
        background: white; cursor: pointer; display: flex; align-items: center; justify-content: center;
        font-weight: bold; font-size: 0.85rem; transition: 0.2s;
    }
    .seat:hover:not(.occupied):not(.selected) { background: #e3f2fd; border-color: #2196f3; transform: scale(1.1); }
    .seat.selected { background: #2196f3; color: white; border-color: #1976d2; box-shadow: 0 0 8px rgba(33, 150, 243, 0.4); }
    .seat.occupied { background: #e0e0e0; color: #9e9e9e; cursor: not-allowed; border-color: #bdbdbd; }
    .seat.legend { width: 15px; height: 15px; border-radius: 3px; display: inline-block; margin-right: 5px; }
    .legend-available { background: white; border: 1px solid #ccc; }
    .legend-selected { background: #2196f3; }
    .legend-occupied { background: #e0e0e0; }
    
    .payment-method-card {
        border: 1px solid #dee2e6; border-radius: 8px; padding: 15px; cursor: pointer;
        background: white; transition: 0.2s; display: flex; align-items: center; justify-content: center;
        width: 100%; margin-bottom: 10px;
    }
    .payment-method-card.active { border-color: #0c206d; background-color: #f0f4ff; font-weight: bold; }
    .payment-fields { background: #f8f9fa; padding: 20px; border-radius: 8px; display: none; }
    .payment-fields.active { display: block; }
</style>

<div class="container mt-5 pb-5">
    <h2 class="booking-header text-uppercase mb-4">Complete Your Booking</h2>

    <div class="card ticket-summary mb-5 shadow-sm">
        <div class="card-body py-4">
            <div class="row align-items-center">
                <div class="col-md-2 border-end">
                    <div class="text-muted small text-uppercase fw-bold">Flight</div>
                    <span class="fs-4 fw-bold" style="color:#0c206d;">@Model.FlightNumber</span>
                </div>
                <div class="col-md-7 px-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-center">
                            <div class="fs-4 fw-800" style="color:#0c206d;">@Model.DepartureCode</div>
                            <div class="text-muted small">@Model.DepartureCity</div>
                            <div class="fw-bold text-primary">@Model.DepartureTime.ToString("HH:mm")</div>
                        </div>
                        <div class="flex-grow-1 mx-4 text-center">
                            <div class="text-muted small mb-1">@Model.DepartureTime.ToString("ddd, dd MMM yyyy")</div>
                            <div style="position:relative;">
                                <hr class="m-0" style="border-top: 2px dashed #cbd5e0;">
                                <i class="bi bi-airplane-fill position-absolute top-50 start-50 translate-middle bg-light px-2 text-primary"></i>
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="fs-4 fw-800" style="color:#0c206d;">@Model.ArrivalCode</div>
                            <div class="text-muted small">@Model.ArrivalCity</div>
                            <div class="fw-bold text-primary">@Model.ArrivalTime.ToString("HH:mm")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-check2-circle me-1"></i> Ready to Book</span>
                </div>
            </div>
        </div>
    </div>

    <form method="post" id="mainBookingForm" novalidate>
        <input type="hidden" asp-for="Input.FlightId" />
        <input type="hidden" asp-for="Input.PassengerCount" />
        <input type="hidden" asp-for="SelectedSeats" id="selected-seats-input" />
        <input type="hidden" asp-for="PaymentMethod" id="payment-method-input" />
        <input type="hidden" asp-for="CardHolderName" id="card-holder-input" />
        <input type="hidden" asp-for="CardNumber" id="card-number-input" />
        <input type="hidden" asp-for="ExpiryDate" id="expiry-input" />
        <input type="hidden" asp-for="CVV" id="cvv-input" />
        <input type="hidden" asp-for="PayPalEmail" id="paypal-email-input" />

        <div class="row">
            <div class="col-lg-8">
                
                <div id="step-1" class="step-section">
                    <h4 class="passenger-title text-uppercase mb-3">1. Traveler Information</h4>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-uppercase small">Select Cabin Class</label>
                        <select asp-for="Input.TicketClass" class="form-select form-select-lg geologica-text" id="ticketClassSelect" style="max-width:350px;" onchange="updateTotal(); loadSeats();">
                            <option value="">-- Choose Class --</option>
                            <option value="Economy">Economy Class (Base)</option>
                            <option value="Business">Business Class (1.5×)</option>
                            <option value="First">First Class (2.0×)</option>
                        </select>
                        <span asp-validation-for="Input.TicketClass" class="text-danger small"></span>
                    </div>

                    @for (int i = 0; i < Model.Input.PassengerCount; i++)
                    {
                        <div class="passenger-section shadow-sm">
                            <h5 class="geologica-text fw-bold mb-4">
                                <span class="passenger-number">@(i + 1)</span> Traveler @(i + 1)
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">First Name</label>
                                    <input asp-for="Input.Passengers[i].FirstName" class="form-control geologica-text" placeholder="First Name" />
                                    <span asp-validation-for="Input.Passengers[i].FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Last Name</label>
                                    <input asp-for="Input.Passengers[i].LastName" class="form-control geologica-text" placeholder="Last Name" />
                                    <span asp-validation-for="Input.Passengers[i].LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Passport Number</label>
                                    <input asp-for="Input.Passengers[i].PassportNumber" class="form-control font-monospace text-uppercase" placeholder="A12345678" />
                                    <span asp-validation-for="Input.Passengers[i].PassportNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Date of Birth</label>
                                    <input asp-for="Input.Passengers[i].DOB" type="date" class="form-control dob-input geologica-text" />
                                    <span asp-validation-for="Input.Passengers[i].DOB" class="text-danger small"></span>
                                    <div class="minor-warning-box minor-age-warning shadow-sm" style="display:none;">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        <strong>Minor Notice:</strong> Passengers ≤14 must be accompanied by an adult.
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <button type="button" class="btn btn-primary w-100 mt-3" onclick="goToStep(2)">Next: Select Seats</button>
                </div>

                <div id="step-2" class="step-section d-none">
                    <h4 class="passenger-title text-uppercase mb-3">2. Choose Your Seats</h4>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-2"></i> Please select <strong>@Model.Input.PassengerCount</strong> seat(s).
                    </div>

                    <div id="seat-grid-loader" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p>Loading seat map...</p>
                    </div>

                    <div id="seat-grid-container" class="seat-grid-container d-none">
                        <div class="mb-3 text-center">
                            <span><span class="seat legend legend-available"></span> Available</span>
                            <span class="mx-2"><span class="seat legend legend-selected"></span> Selected</span>
                            <span><span class="seat legend legend-occupied"></span> Occupied</span>
                        </div>
                        <div id="seat-grid"></div>
                    </div>

                    <div id="seat-error" class="alert alert-danger d-none mt-3"></div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-secondary" onclick="goToStep(1)">Back</button>
                        <button type="button" class="btn btn-primary" onclick="validateAndGoToPayment()">Next: Payment</button>
                    </div>
                </div>

                <div id="step-3" class="step-section d-none">
                    <h4 class="passenger-title text-uppercase mb-3">3. Payment Details</h4>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase">Payment Method</label>
                        <div class="row g-2">
                            @foreach (var method in new[] { "Credit Card", "Debit Card", "PayPal" })
                            {
                                <div class="col-4">
                                    <div class="payment-method-card" onclick="selectPaymentMethod('@method')">
                                        @method
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div id="cardFields" class="payment-fields">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Card Holder Name</label>
                            <input type="text" class="form-control" id="cardHolderInput" placeholder="Name on card" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Card Number</label>
                            <input type="text" class="form-control font-monospace" id="cardNumberInput" placeholder="0000 0000 0000 0000" maxlength="19" />
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold">Expiry (MM/YY)</label>
                                <input type="text" class="form-control" id="expiryInput" placeholder="MM/YY" maxlength="5" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">CVV</label>
                                <input type="text" class="form-control" id="cvvInput" placeholder="123" maxlength="4" />
                            </div>
                        </div>
                    </div>

                    <div id="paypalFields" class="payment-fields">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">PayPal Email</label>
                            <input type="email" class="form-control" id="paypalEmailInput" placeholder="email@example.com" />
                        </div>
                    </div>

                    <div id="payment-error" class="alert alert-danger d-none mt-3"></div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-secondary" onclick="goToStep(2)">Back</button>
                        <button type="submit" class="btn btn-success btn-lg">CONFIRM & PAY $@Model.EstimatedTotal</button>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">
                <div class="card price-checkout-box shadow sticky-top" style="top: 20px; z-index: 10;">
                    <h5 class="geologica-text fw-bold mb-4 border-bottom pb-2 border-secondary">Fare Summary</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Base Fare (@Model.Input.PassengerCount ×)</span>
                        <span>MYR @((Model.BasePrice * Model.Input.PassengerCount).ToString("N2"))</span>
                    </div>
                    <div id="classSurchargeRow" class="d-flex justify-content-between mb-4 small text-info" style="display:none !important;">
                        <span>Cabin Upgrade</span>
                        <span id="surchargeAmount">+ MYR 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <span class="fs-5">Grand Total</span>
                        <div class="text-end">
                            <div class="fs-3 fw-bold" id="liveTotalDisplay">MYR @Model.EstimatedTotal.ToString("N2")</div>
                            <div class="small opacity-75">All taxes included</div>
                        </div>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-warning mt-3 small geologica-text"></div>
                    <a asp-page="/BookFlight" class="btn btn-outline-light btn-sm w-100 mt-4 border-0 opacity-75">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const flightId = @Model.Input.FlightId;
        const passengerCount = @Model.Input.PassengerCount;
        const basePrice = @Model.BasePrice;
        let selectedSeats = [];
        let allSeats = [];
        let occupiedSeats = [];

        function goToStep(step) {
            // Clear errors when moving steps
            document.querySelectorAll('.alert-danger').forEach(el => el.classList.add('d-none'));
            
            document.querySelectorAll('.step-section').forEach(el => el.classList.add('d-none'));
            document.getElementById(`step-${step}`).classList.remove('d-none');
            window.scrollTo(0, 0);
        }

        function updateTotal() {
            const cls = document.getElementById('ticketClassSelect').value;
            const multipliers = { 'Economy': 1, 'Business': 1.5, 'First': 2 };
            const multiplier = multipliers[cls] || 1;
            const total = passengerCount * basePrice * multiplier;
            const surcharge = total - (passengerCount * basePrice);

            document.getElementById('liveTotalDisplay').innerText = 'MYR ' + total.toLocaleString(undefined, {minimumFractionDigits: 2});
            const surchargeRow = document.getElementById('classSurchargeRow');
            if (surcharge > 0) {
                surchargeRow.style.display = 'flex';
                document.getElementById('surchargeAmount').innerText = '+ MYR ' + surcharge.toLocaleString(undefined, {minimumFractionDigits: 2});
            } else {
                surchargeRow.style.display = 'none';
            }
        }

        // Minor Warning Logic
        function calcAge(dob) {
            const today = new Date(); const birthDate = new Date(dob);
            let age = today.getFullYear() - birthDate.getFullYear();
            const m = today.getMonth() - birthDate.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
            return age;
        }
        function updateMinorWarnings() {
            const inputs = Array.from(document.querySelectorAll('.dob-input'));
            const ages = inputs.map(i => i.value ? calcAge(i.value) : null);
            const hasAdult = ages.some(a => a !== null && a > 14);
            inputs.forEach((input, idx) => {
                const warning = input.closest('.col-md-6').querySelector('.minor-age-warning');
                const age = ages[idx];
                warning.style.display = (age !== null && age <= 14 && !hasAdult) ? 'block' : 'none';
            });
        }
        document.querySelectorAll('.dob-input').forEach(input => input.addEventListener('change', updateMinorWarnings));

        async function loadSeats() {
            const cabinClass = document.getElementById('ticketClassSelect').value;
            const errorEl = document.getElementById('seat-error');
            const loaderEl = document.getElementById('seat-grid-loader');
            const containerEl = document.getElementById('seat-grid-container');

            // Reset UI
            errorEl.classList.add('d-none');
            containerEl.classList.add('d-none');
            loaderEl.classList.remove('d-none');

            // 1. Validate Class Selection
            if (!cabinClass) {
                loaderEl.classList.add('d-none');
                errorEl.innerText = "Please select a cabin class before viewing seats.";
                errorEl.classList.remove('d-none');
                return;
            }

            try {
                // 2. Fetch Seats Filtered by Class
                const [seatsRes, occupiedRes] = await Promise.all([
                    fetch(`/api/seats/flight/${flightId}?class=${encodeURIComponent(cabinClass)}`),
                    fetch(`/api/seats/occupied/${flightId}`)
                ]);

                if (!seatsRes.ok) {
                    throw new Error("Failed to load seat data.");
                }

                allSeats = await seatsRes.json();
                occupiedSeats = await occupiedRes.json();

                // 3. Handle Empty Results
                if (allSeats.length === 0) {
                    loaderEl.classList.add('d-none');
                    errorEl.innerText = `No seats available in ${cabinClass} class for this flight.`;
                    errorEl.classList.remove('d-none');
                    return;
                }

                renderGrid();

            } catch (err) {
                console.error(err);
                loaderEl.classList.add('d-none');
                errorEl.innerText = "Failed to load seats. Please try again.";
                errorEl.classList.remove('d-none');
            }
        }

        function renderGrid() {
            const container = document.getElementById('seat-grid');
            container.innerHTML = '';
            
            const selectedClass = document.getElementById('ticketClassSelect').value;
            
            const rows = {};
            allSeats.forEach(seat => {

                const match = seat.seatNumber.match(/^(\d+)([A-Z]+)$/);
                if (match) {
                    const row = match[1];
                    if (!rows[row]) rows[row] = [];
                    rows[row].push(seat);
                }
            });

            // Render rows
            Object.keys(rows).sort((a,b) => parseInt(a) - parseInt(b)).forEach(rowNum => {
                const rowDiv = document.createElement('div');
                rowDiv.className = 'seat-row';
                
                rows[rowNum].sort((a,b) => a.seatNumber.localeCompare(b.seatNumber)).forEach(seat => {
                    const isOccupied = occupiedSeats.includes(seat.seatNumber);
                    const isSelected = selectedSeats.includes(seat.seatNumber);
                    
                    const seatDiv = document.createElement('div');
                    seatDiv.className = `seat ${seat.seatClass.toLowerCase()} ${isOccupied ? 'occupied' : ''} ${isSelected ? 'selected' : ''}`;
                    seatDiv.innerText = seat.seatNumber;
                    
                    if (!isOccupied) {
                        seatDiv.onclick = () => toggleSeat(seat.seatNumber);
                    }
                    rowDiv.appendChild(seatDiv);
                });
                container.appendChild(rowDiv);
            });

            document.getElementById('seat-grid-loader').classList.add('d-none');
            document.getElementById('seat-grid-container').classList.remove('d-none');
        }

        function toggleSeat(seatNumber) {
            const idx = selectedSeats.indexOf(seatNumber);
            if (idx > -1) {
                selectedSeats.splice(idx, 1);
            } else {
                if (selectedSeats.length < passengerCount) {
                    selectedSeats.push(seatNumber);
                } else {
                    alert(`You can only select ${passengerCount} seat(s). Deselect one first.`);
                    return;
                }
            }
            renderGrid();
        }

        function validateAndGoToPayment() {
            const errorEl = document.getElementById('seat-error');
            if (selectedSeats.length !== passengerCount) {
                errorEl.innerText = `You must select exactly ${passengerCount} seat(s). Currently: ${selectedSeats.length}`;
                errorEl.classList.remove('d-none');
                return;
            }
            errorEl.classList.add('d-none');
            document.getElementById('selected-seats-input').value = selectedSeats.join(',');
            goToStep(3);
        }

        //PAYMENT
        function selectPaymentMethod(method) {
            document.querySelectorAll('.payment-method-card').forEach(el => el.classList.remove('active'));
            event.currentTarget.classList.add('active');
            
            document.getElementById('payment-method-input').value = method;
            
            const cardFields = document.getElementById('cardFields');
            const paypalFields = document.getElementById('paypalFields');
            
            if (method === 'PayPal') {
                cardFields.classList.remove('active');
                paypalFields.classList.add('active');
            } else {
                paypalFields.classList.remove('active');
                cardFields.classList.add('active');
            }
        }

        // Formatting
        document.getElementById('cardNumberInput')?.addEventListener('input', function(e) {
            let v = e.target.value.replace(/\D/g,'').substring(0,16);
            e.target.value = v.match(/.{1,4}/g)?.join(' ') ?? v;
        });
        document.getElementById('expiryInput')?.addEventListener('input', function(e) {
            let v = e.target.value.replace(/\D/g,'').substring(0,4);
            if(v.length >= 3) v = v.substring(0,2) + '/' + v.substring(2);
            e.target.value = v;
        });

        // Sync hidden inputs before submit
        document.getElementById('mainBookingForm').addEventListener('submit', function(e) {
            document.getElementById('card-holder-input').value = document.getElementById('cardHolderInput').value;
            document.getElementById('card-number-input').value = document.getElementById('cardNumberInput').value;
            document.getElementById('expiry-input').value = document.getElementById('expiryInput').value;
            document.getElementById('cvv-input').value = document.getElementById('cvvInput').value;
            document.getElementById('paypal-email-input').value = document.getElementById('paypalEmailInput').value;
        });

        if(document.getElementById('step-2')) {
             loadSeats();
        }
    </script>
}
