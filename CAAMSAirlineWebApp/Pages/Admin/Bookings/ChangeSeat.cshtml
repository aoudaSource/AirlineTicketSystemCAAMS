@page
@model CAAMSAirlineWebApp.Pages.Admin.Bookings.ChangeSeatModel
@{
    ViewData["Title"] = "Change Seat";
}

<h2 class="mb-1">Change Seat</h2>
<a asp-page="/Admin/Bookings/Details"
   asp-route-bookingId="@Model.BookingId"
   class="text-muted small mb-4 d-inline-block">&larr; Back to Booking #@Model.BookingId</a>

<div class="card shadow-sm" style="max-width:480px;">
    <div class="card-body">

        <dl class="row mb-4">
            <dt class="col-sm-4 text-muted">Passenger</dt>
            <dd class="col-sm-8 fw-semibold">@Model.PassengerName</dd>

            <dt class="col-sm-4 text-muted">Flight</dt>
            <dd class="col-sm-8">@Model.FlightInfo</dd>

            <dt class="col-sm-4 text-muted">Class</dt>
            <dd class="col-sm-8">
                <span class="badge bg-secondary">@Model.TicketClass</span>
            </dd>

            <dt class="col-sm-4 text-muted">Current Seat</dt>
            <dd class="col-sm-8">
                <span class="badge bg-dark font-monospace fs-6">@Model.CurrentSeat</span>
            </dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="HiddenTicketId" />
            <input type="hidden" asp-for="HiddenBookingId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="SelectedSeatId" class="form-label fw-semibold">
                    Select New Seat
                    <span class="fw-normal text-muted small">(@Model.TicketClass only)</span>
                </label>

                @if (!Model.AvailableSeats.Any())
                {
                    <div class="alert alert-warning py-2">
                        No other @Model.TicketClass seats are available on this flight.
                    </div>
                }
                else
                {
                    <select asp-for="SelectedSeatId" asp-items="Model.AvailableSeats"
                            class="form-select font-monospace">
                        <option value="">-- Choose a seat --</option>
                    </select>
                    <div class="form-text">
                        @Model.AvailableSeats.Count() seat(s) available.
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"
                        @(!Model.AvailableSeats.Any() ? "disabled" : "")>
                    Confirm Seat Change
                </button>
                <a asp-page="/Admin/Bookings/Details"
                   asp-route-bookingId="@Model.BookingId"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
