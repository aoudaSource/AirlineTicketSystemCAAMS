@page
@model CAAMSAirlineWebApp.Pages.Admin.Reports.CustomerLoyaltyModel
@{
    ViewData["Title"] = "Customer Loyalty Report";
}

<style>
    /* Premium Branding Typography */
    .report-header, .card-label, .table thead th {
        font-family: 'Geologica', sans-serif;
        color: #0c206d; /* Your Dark Blue */
        font-weight: 800;
    }

    .geologica-text {
        font-family: 'Geologica', sans-serif;
    }

    /* Top Stats Cards - Matching your Dashboard Style */
    .card-loyalty-stats {
        background-color: #00a4a4 !important;
        color: white !important;
        border: none;
        border-radius: 10px;
        transition: 0.3s;
    }

    .card-label {
        color: rgba(255, 255, 255, 0.8) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Table Styling */
    .table-custom {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #eee;
    }

        .table-custom thead {
            background-color: #f8f9fa;
        }

    /* Custom Back Link */
    .airline-back-link {
        color: #0c206d;
        text-decoration: none;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
    }

        .airline-back-link:hover {
            text-decoration: underline;
        }

    /* Padding for the bottom so it doesn't touch the footer */
    .report-container {
        padding-bottom: 100px;
    }
</style>

<div class="container report-container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="report-header text-uppercase">Customer Loyalty</h2>
    </div>

    <a asp-page="/Admin/Index" class="airline-back-link small mb-4 d-inline-block">
        &larr; Back to Dashboard
    </a>

    <div class="row g-3 mb-5">
        <div class="col-sm-4">
            <div class="card card-loyalty-stats shadow-sm">
                <div class="card-body">
                    <div class="card-label mb-1">Total Customers</div>
                    <div class="fs-4 fw-bold geologica-text">@Model.TotalCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card card-loyalty-stats shadow-sm">
                <div class="card-body">
                    <div class="card-label mb-1">Top 10% Count</div>
                    <div class="fs-4 fw-bold geologica-text">@Model.TopTenPercentCount</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card card-loyalty-stats shadow-sm">
                <div class="card-body">
                    <div class="card-label mb-1">Revenue from Top 10%</div>
                    <div class="fs-4 fw-bold geologica-text">MYR @Model.TopTenPercentRevenue.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="report-header mb-3" style="font-size: 1.2rem;">
        Top @Model.TopTenPercentCount High-Value Customers
        <span class="text-muted fw-normal small d-block d-md-inline">(Top 10% by total spend)</span>
    </h5>

    @if (!Model.TopCustomers.Any())
    {
        <div class="alert alert-info geologica-text">No bookings recorded yet.</div>
    }
    else
    {
        <div class="table-responsive table-custom shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:80px;">Rank</th>
                        <th>Customer Name</th>
                        <th>Email Address</th>
                        <th class="text-center">Bookings</th>
                        <th class="text-end">Total Spent (MYR)</th>
                    </tr>
                </thead>
                <tbody class="geologica-text">
                    @foreach (var c in Model.TopCustomers)
                    {
                        @* Removed the emoji and replaced with a subtle highlight for Rank #1 *@
                        <tr class="@(c.Rank == 1 ? "table-light" : "")">
                            <td class="text-center fw-bold text-muted">
                                #@c.Rank
                            </td>
                            <td class="fw-semibold" style="color: #0c206d;">@c.FullName</td>
                            <td>
                                <a href="mailto:@c.Email" class="text-decoration-none text-secondary">@c.Email</a>
                            </td>
                            <td class="text-center">@c.TotalBookings</td>
                            <td class="text-end fw-bold" style="color: #0c206d;">@c.TotalSpent.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
