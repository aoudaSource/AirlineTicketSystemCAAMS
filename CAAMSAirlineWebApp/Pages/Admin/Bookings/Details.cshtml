@page
@model CAAMSAirlineWebApp.Pages.Admin.Bookings.DetailsModel
@{
    ViewData["Title"] = $"Booking #{Model.Booking.BookingId}";
}

<style>
    /* Premium Branding Typography */
    .report-header, .section-label, .btn-airline-action, .table thead th {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
    }

    .geologica-text {
        font-family: 'Geologica', sans-serif;
    }

    /* Summary Card Styling */
    .summary-card {
        background-color: #0c206d;
        color: white;
        border: none;
        border-radius: 12px;
    }

    .summary-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }

    /* Passenger Card Styling */
    .passenger-card {
        border: 1px solid #e0e6ed;
        border-left: 5px solid #0c206d;
        border-radius: 8px;
    }

    .passenger-header {
        background-color: #f8faff;
        border-bottom: 1px solid #e0e6ed;
    }

    /* Seat Badge Branding */
    .seat-badge {
        background-color: #eef1f7;
        color: #0c206d;
        border: 1px solid #0c206d;
        font-weight: bold;
        padding: 2px 8px;
    }

    /* Table Styles */
    .ticket-table {
        font-size: 0.9rem;
    }

        .ticket-table thead {
            background-color: #f1f3f5;
            border-bottom: 2px solid #dee2e6;
        }

    /* Custom Back Link */
    .airline-back-link {
        color: #0c206d;
        text-decoration: none;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
    }

        .airline-back-link:hover {
            text-decoration: underline;
        }

    .details-container {
        padding-bottom: 120px;
    }
</style>

<div class="container details-container mt-5">
    <div class="d-flex justify-content-between align-items-end mb-1">
        <div>
            <h2 class="report-header text-uppercase mb-0">Booking Manifest Details</h2>
            <span class="geologica-text text-muted small">Record Created: @Model.Booking.BookingDate.ToString("dd MMM yyyy HH:mm")</span>
        </div>
        <div class="text-end">
            <span class="badge bg-success px-3 py-2 rounded-pill">CONFIRMED</span>
        </div>
    </div>

    <a asp-page="/Admin/Bookings/Index" class="airline-back-link small mb-4 d-inline-block">&larr; Back to Booking List</a>

    <div class="card summary-card mb-5 shadow-sm">
        <div class="card-body d-flex justify-content-around py-4">
            <div class="text-center">
                <div class="summary-label">Reference ID</div>
                <div class="fs-4 fw-bold font-monospace">#@Model.Booking.BookingId</div>
            </div>
            <div class="vr opacity-25"></div>
            <div class="text-center">
                <div class="summary-label">Lead Customer</div>
                <div class="fs-4 fw-bold geologica-text">@Model.Booking.Customer.FirstName @Model.Booking.Customer.LastName</div>
            </div>
            <div class="vr opacity-25"></div>
            <div class="text-center">
                <div class="summary-label">Total Payment</div>
                <div class="fs-4 fw-bold geologica-text"><small>MYR</small> @Model.Booking.TotalPrice.ToString("N2")</div>
            </div>
            <div class="vr opacity-25"></div>
            <div class="text-center">
                <div class="summary-label">Total Travelers</div>
                <div class="fs-4 fw-bold geologica-text">@Model.Booking.Passengers.Count</div>
            </div>
        </div>
    </div>

    <h4 class="report-header text-uppercase mb-3">Passenger & Ticket Information</h4>

    @foreach (var passenger in Model.Booking.Passengers)
    {
        <div class="card passenger-card mb-4 shadow-sm">
            <div class="card-header passenger-header d-flex justify-content-between align-items-center py-3">
                <span class="fs-5 fw-bold geologica-text" style="color:#0c206d;">
                    <i class="bi bi-person-circle me-2"></i>@passenger.FirstName @passenger.LastName
                </span>
                <a asp-page="/Admin/Bookings/EditPassenger"
                   asp-route-passengerId="@passenger.PassengerId"
                   asp-route-bookingId="@Model.Booking.BookingId"
                   class="btn btn-sm btn-outline-dark fw-bold px-3">
                    <i class="bi bi-pencil-square me-1"></i> Edit Passport Details
                </a>
            </div>
            <div class="card-body">
                <div class="row mb-4 geologica-text">
                    <div class="col-sm-3">
                        <span class="text-muted small text-uppercase fw-bold">Passport Number</span><br />
                        <span class="fw-bold font-monospace text-primary">@passenger.PassportNumber</span>
                    </div>
                    <div class="col-sm-3">
                        <span class="text-muted small text-uppercase fw-bold">Date of Birth</span><br />
                        <span class="fw-semibold">@passenger.DOB.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                @if (passenger.Tickets.Any())
                {
                    <div class="table-responsive rounded border">
                        <table class="table table-hover ticket-table align-middle mb-0">
                            <thead class="geologica-text small text-uppercase">
                                <tr>
                                    <th>Flight</th>
                                    <th>Route</th>
                                    <th>Departure</th>
                                    <th>Cabin Class</th>
                                    <th class="text-center">Seat</th>
                                    <th class="text-end">Operations</th>
                                </tr>
                            </thead>
                            <tbody class="geologica-text">
                                @foreach (var ticket in passenger.Tickets)
                                {
                                    <tr>
                                        <td class="fw-bold">@ticket.FlightLeg.Flight.FlightNumber</td>
                                        <td>
                                            <span class="fw-semibold">@ticket.FlightLeg.DepartureAirport</span>
                                            <i class="bi bi-arrow-right text-muted mx-1"></i>
                                            <span class="fw-semibold">@ticket.FlightLeg.ArrivalAirport</span>
                                        </td>
                                        <td>
                                            <span class="small">@ticket.FlightLeg.DepartureTime.ToString("dd MMM")</span>
                                            <span class="fw-bold ms-1">@ticket.FlightLeg.DepartureTime.ToString("HH:mm")</span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill border text-dark fw-normal">@ticket.TicketClass</span>
                                        </td>
                                        <td class="text-center">
                                            @if (ticket.Seat != null)
                                            {
                                                <span class="badge seat-badge font-monospace">@ticket.Seat.SeatNumber</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted italic small">Unassigned</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Admin/Bookings/ChangeSeat"
                                               asp-route-ticketId="@ticket.TicketId"
                                               asp-route-bookingId="@Model.Booking.BookingId"
                                               class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-bold">
                                                Change Seat
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>
