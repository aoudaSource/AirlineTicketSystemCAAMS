@page
@model CAAMSAirlineWebApp.Pages.Admin.Reports.CustomerLoyaltyModel
@{
    ViewData["Title"] = "Customer Loyalty Report";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2>Customer Loyalty Report</h2>
</div>
<a asp-page="/Admin/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Dashboard</a>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div class="small">Total Customers</div>
                <div class="fs-4 fw-bold">@Model.TotalCustomers</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="small">Top 10% Count</div>
                <div class="fs-4 fw-bold">@Model.TopTenPercentCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div class="small">Revenue from Top 10%</div>
                <div class="fs-4 fw-bold">MYR @Model.TopTenPercentRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3">
    Top @Model.TopTenPercentCount Customer@(Model.TopTenPercentCount != 1 ? "s" : "")
    <span class="text-muted fw-normal small">(top 10% by total spend — send these a discount code)</span>
</h5>

@if (!Model.TopCustomers.Any())
{
    <div class="alert alert-info">No bookings recorded yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width:60px;">Rank</th>
                    <th>Customer</th>
                    <th>Email</th>
                    <th class="text-center">Bookings</th>
                    <th class="text-end">Total Spent (MYR)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.TopCustomers)
                {
                    <tr class="@(c.Rank == 1 ? "table-warning" : "")">
                        <td class="text-center">
                            <span class="@(c.Rank == 1 ? "fw-bold" : "text-muted")">#@c.Rank</span>
                        </td>
                        <td class="fw-semibold">@c.FullName</td>
                        <td>
                            <a href="mailto:@c.Email" class="text-decoration-none">@c.Email</a>
                        </td>
                        <td class="text-center">@c.TotalBookings</td>
                        <td class="text-end fw-bold text-success">@c.TotalSpent.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
