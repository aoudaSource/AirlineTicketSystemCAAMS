@page
@model CAAMSAirlineWebApp.Pages.Admin.Airports.IndexModel
@{
    ViewData["Title"] = "Manage Airports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Airports</h2>
    <a asp-page="/Admin/Airports/Create" class="btn btn-primary">+ Add Airport</a>
</div>
<a asp-page="/Admin/Index" class="text-muted small mb-3 d-inline-block">&larr; Back to Dashboard</a>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Airport Name</th>
                <th>City</th>
                <th>State</th>
                <th>Country</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Airports)
            {
                <tr>
                    <td><span class="badge bg-secondary font-monospace fs-6">@a.AirportCode</span></td>
                    <td>@a.AirportName</td>
                    <td>@a.City</td>
                    <td class="text-muted">@(a.State ?? "—")</td>
                    <td>@a.Country</td>
                    <td>
                        <a asp-page="/Admin/Airports/Edit"
                           asp-route-airportCode="@a.AirportCode"
                           class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" class="d-inline"
                              onsubmit="return confirm('Delete airport @a.AirportCode (@a.City)? This cannot be undone.');">
                            <input type="hidden" name="airportCode" value="@a.AirportCode" />
                            <button type="submit" asp-page-handler="Delete"
                                    class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
