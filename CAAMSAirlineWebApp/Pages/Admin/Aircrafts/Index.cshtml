@page
@model CAAMSAirlineWebApp.Pages.Admin.Aircrafts.IndexModel
@{
    ViewData["Title"] = "Manage Aircrafts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Aircrafts</h2>
    <a asp-page="/Admin/Aircrafts/Create" class="btn btn-primary">+ Add Aircraft</a>
</div>
<a asp-page="/Admin/Index" class="text-muted small mb-3 d-inline-block">&larr; Back to Dashboard</a>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Model</th>
                <th>Manufacturer</th>
                <th class="text-center">Capacity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Aircrafts)
            {
                <tr>
                    <td class="fw-semibold">@a.Model</td>
                    <td>@(a.Manufacturer ?? "—")</td>
                    <td class="text-center">@a.Capacity</td>
                    <td>
                        <a asp-page="/Admin/Aircrafts/Edit"
                           asp-route-aircraftId="@a.AircraftId"
                           class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" class="d-inline"
                              onsubmit="return confirm('Delete @a.Model? This cannot be undone.');">
                            <input type="hidden" name="aircraftId" value="@a.AircraftId" />
                            <button type="submit" asp-page-handler="Delete"
                                    class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
