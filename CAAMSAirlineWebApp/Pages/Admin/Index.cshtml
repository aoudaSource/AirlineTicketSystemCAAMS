@page
@model CAAMSAirlineWebApp.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Admin Dashboard</h2>
    <span class="text-muted">Welcome, @User.Identity!.Name</span>
</div>

<div class="row g-4 mb-5">
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Total Flights</h5>
                <p class="card-text display-6">@Model.TotalFlights</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">Upcoming Legs</h5>
                <p class="card-text display-6">@Model.UpcomingFlights</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <h5 class="card-title">Airports</h5>
                <p class="card-text display-6">@Model.TotalAirports</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card text-white bg-secondary h-100">
            <div class="card-body">
                <h5 class="card-title">Total Bookings</h5>
                <p class="card-text display-6">@Model.TotalBookings</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <h4 class="mb-3">Bookings</h4>
        <div class="list-group mb-4">
            <a asp-page="/Admin/Bookings/Index" class="list-group-item list-group-item-action">
                Manage Bookings &amp; Passengers
            </a>
        </div>
        <h4 class="mb-3">Flight Management</h4>
        <div class="list-group mb-4">
            <a asp-page="/Admin/Flights/Index" class="list-group-item list-group-item-action">
                @(User.IsInRole("Admin") ? "Manage Flights" : "View Flights")
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="/Admin/Flights/Create" class="list-group-item list-group-item-action">
                    Add New Flight
                </a>
            }
        </div>
        @if (User.IsInRole("Admin"))
        {
            <h4 class="mb-3">Fleet &amp; Infrastructure</h4>
            <div class="list-group">
                <a asp-page="/Admin/Airports/Index" class="list-group-item list-group-item-action">
                    Manage Airports
                </a>
                <a asp-page="/Admin/Aircrafts/Index" class="list-group-item list-group-item-action">
                    Manage Aircrafts
                </a>
            </div>
        }
    </div>
    <div class="col-md-6">
        <h4 class="mb-3">Reports</h4>
        <div class="list-group">
            <a asp-page="/Admin/Reports/RouteProfitability" class="list-group-item list-group-item-action">
                Route Profitability
            </a>
            <a asp-page="/Admin/Reports/CustomerLoyalty" class="list-group-item list-group-item-action">
                Customer Loyalty (Top 10%)
            </a>
            <a asp-page="/Admin/Reports/DailyRevenue" class="list-group-item list-group-item-action">
                Daily Revenue (Last 24h)
            </a>
            <a asp-page="/Admin/Reports/MostBookedFlights" class="list-group-item list-group-item-action">
                Most Popular Destinations
            </a>
        </div>
    </div>
</div>
