@page
@model CAAMSAirlineWebApp.Pages.BookingConfirmationModel
@{
    ViewData["Title"] = "Booking Confirmed";
}

<style>
    .boarding-pass {
        display: flex;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.12);
        margin-bottom: 24px;
        background: white;
    }

    .boarding-pass-main {
        flex: 1;
        padding: 24px 28px;
        border-right: 2px dashed #dee2e6;
        position: relative;
    }

    .boarding-pass-stub {
        width: 160px;
        background-color: #0c206d;
        color: white;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
    }

    .airline-label {
        font-family: 'Geologica', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        color: #0c206d;
        letter-spacing: 1px;
    }

    .airport-code {
        font-family: 'Geologica', sans-serif;
        font-size: 2.8rem;
        font-weight: 800;
        color: #0c206d;
        line-height: 1;
    }

    .airport-city {
        font-size: 0.8rem;
        color: #6c757d;
        margin-top: 2px;
    }

    .flight-arrow {
        font-size: 1.4rem;
        color: #0c206d;
        padding: 0 12px;
    }

    .bp-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        margin-bottom: 2px;
    }

    .bp-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #212529;
    }

    .stub-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.75;
        margin-bottom: 2px;
    }

    .stub-value {
        font-size: 0.95rem;
        font-weight: 700;
    }

    .passenger-name-header {
        font-family: 'Geologica', sans-serif;
        font-weight: 800;
        color: #0c206d;
        font-size: 1.1rem;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e9ecef;
    }

    .notch {
        width: 20px;
        height: 20px;
        background: #f8f9fa;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }

    .notch-left {
        left: -10px;
    }

    .notch-right {
        right: -10px;
    }

    .confirmation-banner {
        background: linear-gradient(135deg, #0c206d, #1a3a9c);
        color: white;
        border-radius: 12px;
        padding: 20px 28px;
        margin-bottom: 28px;
    }
</style>

<div class="confirmation-banner d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <div class="fs-5 fw-bold">&#10003; Booking Confirmed!</div>
        <div class="opacity-75 small">Your booking reference is <strong>#@Model.Booking.BookingId.ToString("D6")</strong></div>
    </div>
    <div class="d-flex gap-4 flex-wrap">
        <div>
            <div class="opacity-75 small">Booking Date</div>
            <div class="fw-semibold">@Model.Booking.BookingDate.ToString("MMM dd, yyyy hh:mm tt")</div>
        </div>
        <div>
            <div class="opacity-75 small">Total Paid</div>
            <div class="fw-bold fs-5">$@Model.Booking.TotalPrice.ToString("F2")</div>
        </div>
    </div>
</div>

@foreach (var passenger in Model.Booking.Passengers.OrderBy(p => p.PassengerId))
{
    <div class="passenger-name-header">
        &#128100; @passenger.FirstName @passenger.LastName
        <span class="text-muted fw-normal small ms-3">Passport: @passenger.PassportNumber &nbsp;|&nbsp; DOB: @passenger.DOB.ToString("MMM dd, yyyy")</span>
    </div>

    @foreach (var ticket in passenger.Tickets.OrderBy(t => t.FlightLeg.LegNumber))
    {
        var leg = ticket.FlightLeg;
        var dep = leg.DepartureAirportNavigation;
        var arr = leg.ArrivalAirportNavigation;

        <div class="boarding-pass">
            <div class="boarding-pass-main">
                <div class="notch notch-right"></div>

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="airline-label">CAAMS AIRLINES</div>
                    <span class="badge bg-secondary">@ticket.TicketClass</span>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div>
                        <div class="airport-code">@leg.DepartureAirport</div>
                        <div class="airport-city">@dep.City</div>
                        <div class="fw-semibold mt-1">@leg.DepartureTime.ToString("hh:mm tt")</div>
                    </div>
                    <div class="flight-arrow px-3">✈</div>
                    <div>
                        <div class="airport-code">@leg.ArrivalAirport</div>
                        <div class="airport-city">@arr.City</div>
                        <div class="fw-semibold mt-1">@leg.ArrivalTime.ToString("hh:mm tt")</div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-auto">
                        <div class="bp-label">Date</div>
                        <div class="bp-value">@leg.DepartureTime.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-auto">
                        <div class="bp-label">Flight</div>
                        <div class="bp-value">@leg.Flight.FlightNumber</div>
                    </div>
                    <div class="col-auto">
                        <div class="bp-label">Seat</div>
                        <div class="bp-value">@(ticket.Seat != null ? ticket.Seat.SeatNumber : "TBA")</div>
                    </div>
                    <div class="col-auto">
                        <div class="bp-label">Ticket</div>
                        <div class="bp-value">#@ticket.TicketId.ToString("D6")</div>
                    </div>
                    <div class="col-auto">
                        <div class="bp-label">Passenger</div>
                        <div class="bp-value">@passenger.FirstName @passenger.LastName</div>
                    </div>
                </div>
            </div>

            <div class="boarding-pass-stub">
                <div>
                    <div class="stub-label">Flight</div>
                    <div class="stub-value">@leg.Flight.FlightNumber</div>
                </div>
                <div>
                    <div class="stub-label">From</div>
                    <div class="stub-value">@leg.DepartureAirport</div>
                </div>
                <div>
                    <div class="stub-label">To</div>
                    <div class="stub-value">@leg.ArrivalAirport</div>
                </div>
                <div>
                    <div class="stub-label">Seat</div>
                    <div class="stub-value">@(ticket.Seat != null ? ticket.Seat.SeatNumber : "TBA")</div>
                </div>
                <div>
                    <div class="stub-label">Price</div>
                    <div class="stub-value">$@ticket.Price.ToString("F2")</div>
                </div>
            </div>
        </div>
    }
}

<div class="mt-3 d-flex gap-2">
    <a asp-page="/BookFlight" class="btn btn-primary">Book Another Flight</a>
    <a asp-page="/Index" class="btn btn-outline-secondary">Home</a>
</div>
