@page
@model CAAMSAirlineWebApp.Pages.Admin.Flights.IndexModel
@{
    ViewData["Title"] = "Manage Flights";
}

<style>
    /* Premium Branding Typography */
    .report-header, .table thead th, .flight-no {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
        font-weight: 800;
    }

    .geologica-text {
        font-family: 'Geologica', sans-serif;
    }

    /* Search Bar Styling */
    .search-input:focus {
        border-color: #3c81bd;
        box-shadow: 0 0 0 0.25rem rgba(60, 129, 189, 0.15);
    }

    .btn-airline-search {
        background-color: #0c206d !important;
        border-color: #0c206d !important;
        color: white !important;
        font-weight: 600;
    }

    /* Primary Action Button */
    .btn-airline-add {
        background-color: #0c206d !important;
        border-color: #0c206d !important;
        color: white !important;
        font-family: 'Geologica', sans-serif;
        font-weight: 600;
        transition: 0.3s;
        padding: 8px 20px;
    }

        .btn-airline-add:hover {
            background-color: #08164d !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .table-custom {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #eee;
        background: white;
    }

        .table-custom thead {
            background-color: #f8faff;
        }

    .airline-back-link {
        color: #0c206d;
        text-decoration: none;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
    }
</style>

<div class="container mt-5 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="report-header text-uppercase mb-0">Flight Management</h2>
        @* Only Admins see the Create button *@
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Admin/Flights/Create" class="btn btn-airline-add">+ Add New Flight</a>
        }
    </div>

    <div class="card border-0 shadow-sm mb-4 p-3 bg-light">
        <form method="get" class="d-flex gap-2" style="max-width:600px;">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search" style="color:#0c206d;"></i></span>
                <input type="text" name="Query" value="@Model.Query"
                       class="form-control border-start-0 search-input geologica-text"
                       placeholder="Search Flight #, Aircraft, or City...">
            </div>
            <button type="submit" class="btn btn-airline-search px-4 shadow-sm">Search</button>
            @if (!string.IsNullOrEmpty(Model.Query))
            {
                <a asp-page="/Admin/Flights/Index" class="btn btn-outline-secondary geologica-text">Clear</a>
            }
        </form>
    </div>

    <a asp-page="/Admin/Index" class="airline-back-link small mb-4 d-inline-block">&larr; Back to Dashboard</a>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show geologica-text" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Flights == null || !Model.Flights.Any())
    {
        <div class="alert alert-info border-0 shadow-sm geologica-text">
            <i class="bi bi-info-circle-fill me-2"></i>
            @(string.IsNullOrEmpty(Model.Query) ? "No flights found." : "No matching travel records found.")
        </div>
    }
    else
    {
        <div class="table-responsive table-custom shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Flight #</th>
                        <th>Aircraft</th>
                        <th>Route</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Price</th>
                        @* Action header only visible to Admins *@
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-center">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="geologica-text">
                    @foreach (var f in Model.Flights)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="flight-no">@f.FlightNumber</span>
                            </td>
                            <td class="text-muted small">@f.Aircraft</td>
                            <td>
                                <div class="fw-bold" style="color: #0c206d;">@f.Route</div>
                                <div class="small text-muted">@f.DepartureCity &rarr; @f.ArrivalCity</div>
                            </td>
                            <td>
                                <div class="small">@f.DepartureTime.ToString("dd MMM yyyy")</div>
                                <div class="fw-bold">@f.DepartureTime.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="small">@f.ArrivalTime.ToString("dd MMM yyyy")</div>
                                <div class="fw-bold">@f.ArrivalTime.ToString("HH:mm")</div>
                            </td>
                            <td class="fw-bold">USD @f.BasePrice.ToString("N2")</td>
                            
                            @* Action buttons only rendered for Admins *@
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-page="/Admin/Flights/Edit" asp-route-flightId="@f.FlightId" asp-route-legId="@f.LegId"
                                           class="btn btn-sm btn-outline-secondary px-3">Edit</a>
                                        
                                        <form method="post" class="d-inline" onsubmit="return confirm('Delete flight @f.FlightNumber?');">
                                            <input type="hidden" name="flightId" value="@f.FlightId" />
                                            <button type="submit" asp-page-handler="Delete" class="btn btn-sm btn-outline-danger px-3">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
