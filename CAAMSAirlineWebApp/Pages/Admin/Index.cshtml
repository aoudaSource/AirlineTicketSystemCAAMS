@page
@model CAAMSAirlineWebApp.Pages.Admin.IndexModel
@{
    string roleName = User.IsInRole("Admin") ? "Admin" : "Staff";
    ViewData["Title"] = $"{roleName} Dashboard";
}

<style>
    .admin-header, .card-title, .section-title {
        font-family: 'Geologica', sans-serif;
        font-weight: 800;
        color: #0c206d;
    }

    .card-custom-stats {
        background-color: #00a4a4 !important;
        color: white !important;
        border: none;
        border-radius: 10px;
        transition: 0.3s;
    }

    .list-group-item-custom {
        background-color: #f0f0f0 !important;
        color: #0c206d !important;
        font-family: 'Geologica', sans-serif;
        font-weight: 500;
        border: 1px solid #ddd !important;
        margin-bottom: 8px;
        border-radius: 8px !important;
        transition: 0.3s;
        text-decoration: none;
    }

        .list-group-item-custom:hover {
            background-color: #e2e2e2 !important;
            transform: translateX(5px);
            color: #0c206d !important;
        }

    .admin-container {
        padding-bottom: 60px;
    }
</style>

<div class="container admin-container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="admin-header text-uppercase">@roleName Dashboard</h2>
        <span class="text-muted">Logged in as: <strong>@User.Identity!.Name</strong></span>
    </div>

    @* STATS SECTION *@
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card card-custom-stats h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title text-white opacity-75">Total Flights</h5>
                    <p class="card-text display-6 fw-bold">@Model.TotalFlights</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card card-custom-stats h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title text-white opacity-75">Upcoming Legs</h5>
                    <p class="card-text display-6 fw-bold">@Model.UpcomingFlights</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card card-custom-stats h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title text-white opacity-75">Airports</h5>
                    <p class="card-text display-6 fw-bold">@Model.TotalAirports</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card card-custom-stats h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title text-white opacity-75">Total Bookings</h5>
                    <p class="card-text display-6 fw-bold">@Model.TotalBookings</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-5">
        @* LEFT COLUMN: Operations *@
        <div class="col-md-6">
            <h4 class="section-title mb-3">Bookings</h4>
            <div class="list-group mb-4">
                <a asp-page="/Admin/Bookings/Index" class="list-group-item list-group-item-action list-group-item-custom">
                    Manage Bookings &amp; Passengers
                </a>
            </div>

            <h4 class="section-title mb-3">Flight Management</h4>
            <div class="list-group mb-4">
                <a asp-page="/Admin/Flights/Index" class="list-group-item list-group-item-action list-group-item-custom">
                    @(User.IsInRole("Admin") ? "Manage Flights" : "View Flights")
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Flights/Create" class="list-group-item list-group-item-action list-group-item-custom">
                        Add New Flight
                    </a>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <h4 class="section-title mb-3">Fleet &amp; Infrastructure</h4>
                <div class="list-group">
                    <a asp-page="/Admin/Airports/Index" class="list-group-item list-group-item-action list-group-item-custom">
                        Manage Airports
                    </a>
                    <a asp-page="/Admin/Aircrafts/Index" class="list-group-item list-group-item-action list-group-item-custom">
                        Manage Aircrafts
                    </a>
                </div>
            }
        </div>

        @* RIGHT COLUMN: Admin Tools & Reports *@
        <div class="col-md-6">
            @* YOUR PART: User & Staff Management (Admin Only) *@
            @if (User.IsInRole("Admin"))
            {
                <h4 class="section-title mb-3">User &amp; Staff Management</h4>
                <div class="list-group mb-4">
                    <a asp-page="/Admin/AddStaff" class="list-group-item list-group-item-action list-group-item-custom">
                        <i class="bi bi-person-plus-fill me-2"></i> Register New Staff Member
                    </a>
                </div>
            }

            @* REPORTS SECTION *@
            <h4 class="section-title mb-3">Reports &amp; Analytics</h4>
            <div class="list-group">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Reports/TotalRevenue" class="list-group-item list-group-item-action list-group-item-custom">
                        Total Revenue
                    
                    </a>
                    <a asp-page="/Admin/Reports/RouteProfitability" class="list-group-item list-group-item-action list-group-item-custom">
                        Route Profitability
                    </a>
                }

                @* Both Admin and Staff can see Loyalty *@
                <a asp-page="/Admin/Reports/CustomerLoyalty" class="list-group-item list-group-item-action list-group-item-custom">
                    Customer Loyalty (Top 10%)
                </a>
            </div>
        </div>
    </div>
</div>