@page
@model CAAMSAirlineWebApp.Pages.Admin.Aircrafts.EditModel
@{
    ViewData["Title"] = "Edit Aircraft";
}

<style>
    /* Premium Branding Typography */
    .edit-header, .form-label, .btn-airline-save {
        font-family: 'Geologica', sans-serif;
        color: #0c206d;
        font-weight: 700;
    }

    .geologica-text {
        font-family: 'Geologica', sans-serif;
    }

    /* Form Card Styling */
    .edit-card {
        border: none;
        border-radius: 12px;
        background-color: #ffffff;
    }

    /* Input Focus Effects */
    .form-control:focus {
        border-color: #3c81bd;
        box-shadow: 0 0 0 0.25rem rgba(60, 129, 189, 0.15);
    }

    /* Primary Action Button */
    .btn-airline-save {
        background-color: #0c206d !important;
        border-color: #0c206d !important;
        color: white !important;
        padding: 10px 25px;
        transition: 0.3s;
        font-weight: 600;
    }

        .btn-airline-save:hover {
            background-color: #08164d !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    /* Custom Back Link */
    .airline-back-link {
        color: #0c206d;
        text-decoration: none;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
    }

        .airline-back-link:hover {
            text-decoration: underline;
        }

    /* Spacing for footer */
    .edit-container {
        padding-bottom: 120px;
    }
</style>

<div class="container edit-container mt-5">
    <h2 class="edit-header text-uppercase mb-1">Update Aircraft Specifications</h2>
    <a asp-page="/Admin/Aircrafts/Index" class="airline-back-link small mb-4 d-inline-block">&larr; Back to Fleet</a>

    <div class="card edit-card shadow-sm" style="max-width:500px;">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Input.AircraftId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 geologica-text small"></div>

                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="Input.Model" class="form-label">Aircraft Model Designation</label>
                        <input asp-for="Input.Model" class="form-control geologica-text fw-bold" placeholder="e.g. Boeing 737-800" />
                        <span asp-validation-for="Input.Model" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Manufacturer" class="form-label">
                            Manufacturer <span class="text-muted fw-normal small">(Optional)</span>
                        </label>
                        <input asp-for="Input.Manufacturer" class="form-control geologica-text" placeholder="e.g. Airbus" />
                        <span asp-validation-for="Input.Manufacturer" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-8">
                        <label asp-for="Input.Capacity" class="form-label">Total Seat Capacity</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-people-fill" style="color:#0c206d;"></i></span>
                            <input asp-for="Input.Capacity" class="form-control geologica-text" type="number" min="1" max="1000" />
                        </div>
                        <span asp-validation-for="Input.Capacity" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.MaintenanceStatus" class="form-label">Maintenance Status</label>
                        <select asp-for="Input.MaintenanceStatus" class="form-select geologica-text">
                            <option value="Active">Active</option>
                            <option value="In Maintenance">In Maintenance</option>
                        </select>
                        <span asp-validation-for="Input.MaintenanceStatus" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-5 d-flex gap-3">
                    <button type="submit" class="btn btn-airline-save shadow-sm">Save Specifications</button>
                    <a asp-page="/Admin/Aircrafts/Index" class="btn btn-outline-secondary geologica-text px-4" style="padding-top:10px;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}