@page
@model CAAMSAirlineWebApp.Pages.Admin.Reports.MostBookedFlightsModel
@{
    ViewData["Title"] = "Most Popular Destinations";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2>Most Popular Destinations</h2>
</div>
<a asp-page="/Admin/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Dashboard</a>

<p class="text-muted">Destinations ranked by total tickets sold across all flights arriving there.</p>

@if (!Model.Destinations.Any())
{
    <div class="alert alert-info">No booking data yet. Bookings will appear here once customers start booking flights.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="text-center">#</th>
                    <th>Destination</th>
                    <th>Country</th>
                    <th class="text-center">Scheduled Arrivals</th>
                    <th class="text-center">Tickets Sold</th>
                    <th class="text-end">Total Revenue (MYR)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Destinations)
                {
                    <tr>
                        <td class="text-center fw-bold text-muted">@d.Rank</td>
                        <td>
                            <span class="fw-bold fs-5">@d.AirportCode</span>
                            <span class="text-muted ms-2">@d.City</span>
                        </td>
                        <td class="text-muted">@d.Country</td>
                        <td class="text-center">@d.TotalLegs</td>
                        <td class="text-center">
                            @if (d.TicketsSold == 0)
                            {
                                <span class="text-muted">0</span>
                            }
                            else
                            {
                                <span class="fw-semibold">@d.TicketsSold</span>
                            }
                        </td>
                        <td class="text-end fw-semibold">@d.TotalRevenue.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-semibold">
                <tr>
                    <td colspan="4">Total</td>
                    <td class="text-center">@Model.Destinations.Sum(d => d.TicketsSold)</td>
                    <td class="text-end">@Model.Destinations.Sum(d => d.TotalRevenue).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
}
