@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:60vh; text-align:center;">
    <h1>Welcome to CAAMS Airline</h1>
    <p class="text-muted mb-4">Book flights, manage your trips, and more.</p>

    <div style="display:flex; gap:2rem; margin-top:1rem;">
        <div class="card" style="width:220px; padding:2rem;">
            <h4>Have an account?</h4>
            <p class="text-muted">Sign in to book flights and manage your bookings.</p>
            <a asp-page="/Login" class="btn btn-primary w-100">Login</a>
        </div>

        <div class="card" style="width:220px; padding:2rem;">
            <h4>New here?</h4>
            <p class="text-muted">Create a free account to get started.</p>
            <a asp-page="/Register" class="btn btn-success w-100">Create Account</a>
        </div>
    </div>
</div>
