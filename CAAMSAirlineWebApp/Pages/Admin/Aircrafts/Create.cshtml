@page
@model CAAMSAirlineWebApp.Pages.Admin.Aircrafts.CreateModel
@{
    ViewData["Title"] = "Add Aircraft";
}

<h2 class="mb-1">Add Aircraft</h2>
<a asp-page="/Admin/Aircrafts/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Aircrafts</a>

<div class="card shadow-sm" style="max-width:440px;">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">

                <div class="col-12">
                    <label asp-for="Input.Model" class="form-label"></label>
                    <input asp-for="Input.Model" class="form-control"
                           placeholder="e.g. Boeing 737-800" />
                    <span asp-validation-for="Input.Model" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Manufacturer" class="form-label">
                        Manufacturer <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <input asp-for="Input.Manufacturer" class="form-control"
                           placeholder="e.g. Boeing" />
                    <span asp-validation-for="Input.Manufacturer" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.Capacity" class="form-label"></label>
                    <input asp-for="Input.Capacity" class="form-control" type="number" min="1" max="1000" />
                    <span asp-validation-for="Input.Capacity" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Add Aircraft</button>
                <a asp-page="/Admin/Aircrafts/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
