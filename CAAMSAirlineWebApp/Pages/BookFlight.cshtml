@page
@model CAAMSAirlineWebApp.Pages.BookFlightModel
@{
    ViewData["Title"] = "Book a Flight";
}

<style>
    .search-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.12);
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
    }

    .trip-type-group .form-check-input {
        cursor: pointer;
    }

    .trip-type-group .form-check-label {
        cursor: pointer;
        font-weight: 500;
    }

    .location-group {
        position: relative;
        display: flex;
        align-items: flex-end;
        gap: 0;
    }

    .location-group .form-control {
        border-radius: 4px;
    }

    .swap-btn {
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        margin: 0 6px;
        margin-bottom: 1px;
        font-size: 1rem;
        transition: background 0.15s;
        color: #0d6efd;
    }

    .swap-btn:hover {
        background: #e9f0ff;
    }

    .find-flights-btn {
        background-color: #003580;
        color: #fff;
        border: none;
        padding: 0.65rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 4px;
        white-space: nowrap;
    }

    .find-flights-btn:hover {
        background-color: #002a6a;
        color: #fff;
    }

    .cabin-class-group .form-check-input {
        cursor: pointer;
    }

    .cabin-class-group .form-check-label {
        cursor: pointer;
    }
</style>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@* ── SEARCH FORM ── *@
<div class="search-card">
    <form method="get" novalidate>

        @* Trip Type *@
        <div class="trip-type-group d-flex gap-4 mb-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Search.TripType" id="tripRoundTrip"
                       value="RoundTrip" @(Model.Search.TripType == "RoundTrip" ? "checked" : "") />
                <label class="form-check-label" for="tripRoundTrip">Roundtrip</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Search.TripType" id="tripOneWay"
                       value="OneWay" @(Model.Search.TripType == "OneWay" ? "checked" : "") />
                <label class="form-check-label" for="tripOneWay">One-way</label>
            </div>
        </div>

        @* Main inputs row *@
        <div class="row g-2 align-items-end flex-wrap">

            @* From / Swap / To *@
            <div class="col-12 col-md-auto flex-grow-1">
                <div class="location-group">
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold mb-1 small text-muted">From</label>
                        <input asp-for="Search.Origin" class="form-control" placeholder="City or airport" autocomplete="off" />
                        <span asp-validation-for="Search.Origin" class="text-danger small"></span>
                    </div>
                    <button type="button" class="swap-btn" id="swapBtn" title="Swap">⇄</button>
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold mb-1 small text-muted">To</label>
                        <input asp-for="Search.Destination" class="form-control" placeholder="City or airport" autocomplete="off" />
                        <span asp-validation-for="Search.Destination" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @* Departure Date *@
            <div class="col-6 col-md-auto">
                <label class="form-label fw-semibold mb-1 small text-muted">Depart</label>
                <input asp-for="Search.DepartureDate" type="date" class="form-control" style="min-width:145px;" />
                <span asp-validation-for="Search.DepartureDate" class="text-danger small"></span>
            </div>

            @* Return Date *@
            <div class="col-6 col-md-auto" id="returnDateGroup">
                <label class="form-label fw-semibold mb-1 small text-muted">Return</label>
                <input asp-for="Search.ReturnDate" type="date" class="form-control" style="min-width:145px;" />
                <span asp-validation-for="Search.ReturnDate" class="text-danger small"></span>
            </div>

            @* Travelers *@
            <div class="col-6 col-md-auto">
                <label class="form-label fw-semibold mb-1 small text-muted">Travelers</label>
                <select asp-for="Search.PassengerCount" class="form-select" style="min-width:130px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <option value="@i">@i Adult@(i > 1 ? "s" : "")</option>
                    }
                </select>
            </div>

            @* Cabin Class *@
            <div class="col-6 col-md-auto">
                <label class="form-label fw-semibold mb-1 small text-muted">Cabin</label>
                <select asp-for="Search.CabinClass" class="form-select" style="min-width:130px;">
                    <option value="Economy">Economy</option>
                    <option value="Business">Business</option>
                    <option value="First">First Class</option>
                </select>
            </div>

            @* Submit *@
            <div class="col-12 col-md-auto mt-1">
                <button type="submit" class="find-flights-btn btn w-100">Find Flights</button>
            </div>

            @* View All *@
            <div class="col-12 col-md-auto mt-1">
                <a asp-page="/BookFlight" asp-route-showAll="true" class="btn btn-outline-secondary w-100">View All Available Flights</a>
            </div>

        </div>

    </form>
</div>

@* ── STEP 2: RESULTS ── *@
@if (Model.PageStep == "results")
{
    <h5 class="mb-3">
        @Model.SearchResults.Count flight(s) found &mdash;
        @if (Model.ShowAll)
        {
            <span class="text-muted fw-normal">All Available Flights</span>
        }
        else
        {
            <span class="text-muted fw-normal">@Model.Search.Origin → @Model.Search.Destination on @Model.Search.DepartureDate?.ToString("MMM dd, yyyy")</span>
        }
    </h5>

    @if (!Model.SearchResults.Any())
    {
        <div class="alert alert-info">No flights found for your search. Try a different date or location.</div>
    }
    else
    {
        @foreach (var flight in Model.SearchResults)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <span class="fw-bold fs-5">@flight.FlightNumber</span>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="d-flex align-items-center justify-content-center gap-2">
                                <div>
                                    <div class="fw-bold">@flight.DepartureCode</div>
                                    <div class="text-muted small">@flight.DepartureCity</div>
                                </div>
                                <span class="text-muted">──→</span>
                                <div>
                                    <div class="fw-bold">@flight.ArrivalCode</div>
                                    <div class="text-muted small">@flight.ArrivalCity</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-center text-muted small">
                            @flight.DepartureTime.ToString("hh:mm tt") &ndash; @flight.ArrivalTime.ToString("hh:mm tt")
                            <br />@flight.DepartureTime.ToString("MMM dd, yyyy")
                        </div>
                        <div class="col-md-2 text-center">
                            @if (flight.IsFull)
                            {
                                <span class="badge bg-danger">Full</span>
                            }
                            else
                            {
                                <div class="text-muted small">from</div>
                                <div class="fw-bold fs-5">$@flight.BasePrice.ToString("F2")</div>
                            }
                        </div>
                        <div class="col-md-1 text-end">
                            @if (flight.IsFull)
                            {
                                <button class="btn btn-secondary btn-sm" disabled>Full</button>
                            }
                            else
                            {
                                <a asp-page="/BookingForm"
                                   asp-route-flightId="@flight.FlightId"
                                   asp-route-passengerCount="@Model.Search.PassengerCount"
                                   asp-route-cabinClass="@Model.Search.CabinClass"
                                   class="btn btn-success btn-sm">Book</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}


@section Scripts {
    <script>
        // Show/hide return date based on trip type radio buttons
        const returnDateGroup = document.getElementById('returnDateGroup');
        const tripRadios = document.querySelectorAll('input[name="Search.TripType"]');

        function toggleReturnDate() {
            const selected = document.querySelector('input[name="Search.TripType"]:checked');
            if (returnDateGroup) {
                returnDateGroup.style.display = selected && selected.value === 'RoundTrip' ? '' : 'none';
            }
        }

        tripRadios.forEach(r => r.addEventListener('change', toggleReturnDate));
        toggleReturnDate();

        // Swap From / To
        const swapBtn = document.getElementById('swapBtn');
        const originInput = document.getElementById('Search_Origin');
        const destInput = document.getElementById('Search_Destination');

        if (swapBtn && originInput && destInput) {
            swapBtn.addEventListener('click', function () {
                const temp = originInput.value;
                originInput.value = destInput.value;
                destInput.value = temp;
            });
        }
    </script>
}
