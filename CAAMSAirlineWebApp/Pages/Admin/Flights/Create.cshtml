@page
@model CAAMSAirlineWebApp.Pages.Admin.Flights.CreateModel
@{
    ViewData["Title"] = "Add New Flight";
}

<h2 class="mb-1">Add New Flight</h2>
<a asp-page="/Admin/Flights/Index" class="text-muted small mb-4 d-inline-block">&larr; Back to Flights</a>

<div class="card shadow-sm" style="max-width:640px;">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="display:none;"></div>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-sm-6">
                    <label asp-for="Input.FlightNumber" class="form-label"></label>
                    <input asp-for="Input.FlightNumber" class="form-control text-uppercase"
                           placeholder="e.g. MH999" />
                    <span asp-validation-for="Input.FlightNumber" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.BasePrice" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">MYR</span>
                        <input asp-for="Input.BasePrice" class="form-control" type="number" min="1" step="0.01" />
                    </div>
                    <span asp-validation-for="Input.BasePrice" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.AircraftId" class="form-label"></label>
                    <select asp-for="Input.AircraftId" asp-items="Model.AircraftOptions"
                            class="form-select">
                        <option value="">-- Select Aircraft --</option>
                    </select>
                    <span asp-validation-for="Input.AircraftId" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.DepartureAirport" class="form-label"></label>
                    <select asp-for="Input.DepartureAirport" asp-items="Model.AirportOptions"
                            class="form-select">
                        <option value="">-- Select Airport --</option>
                    </select>
                    <span asp-validation-for="Input.DepartureAirport" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.ArrivalAirport" class="form-label"></label>
                    <select asp-for="Input.ArrivalAirport" asp-items="Model.AirportOptions"
                            class="form-select">
                        <option value="">-- Select Airport --</option>
                    </select>
                    <span asp-validation-for="Input.ArrivalAirport" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.DepartureTime" class="form-label"></label>
                    <input asp-for="Input.DepartureTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="Input.DepartureTime" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.ArrivalTime" class="form-label"></label>
                    <input asp-for="Input.ArrivalTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="Input.ArrivalTime" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Flight</button>
                <a asp-page="/Admin/Flights/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
