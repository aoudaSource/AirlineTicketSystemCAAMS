@page
@model CAAMSAirlineWebApp.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<style>
    .bookings-header {
        font-family: 'Geologica', sans-serif;
        font-weight: 700;
        color: #1a3a5c;
        margin: 30px 0 10px;
    }

    .section-label {
        font-family: 'Geologica', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        color: #3c81bd;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 30px 0 12px;
        border-bottom: 2px solid #3c81bd;
        padding-bottom: 6px;
    }

    .booking-card {
        border: 1px solid #dce6f0;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 16px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(60,129,189,0.07);
    }

        .booking-card.past {
            background: #f8f9fa;
            border-color: #e0e0e0;
        }

    .booking-id {
        font-size: 0.8rem;
        color: #888;
        font-family: 'Geologica', sans-serif;
    }

    .flight-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 10px 0;
        flex-wrap: wrap;
    }

    .airport-code {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a3a5c;
        font-family: 'Geologica', sans-serif;
    }

    .airport-name {
        font-size: 0.75rem;
        color: #888;
    }

    .flight-arrow {
        color: #3c81bd;
        font-size: 1.2rem;
        flex: 1;
        text-align: center;
    }

    .flight-time {
        font-size: 0.85rem;
        color: #555;
        font-family: 'Geologica', sans-serif;
    }

    .flight-number-badge {
        background: #3c81bd;
        color: white;
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 0.8rem;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
    }

    .badge-class {
        background: #e8f0fb;
        color: #3c81bd;
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .booking-meta {
        font-size: 0.82rem;
        color: #777;
        margin-top: 10px;
    }

    .total-price {
        font-size: 1rem;
        font-weight: 700;
        color: #1a3a5c;
    }

    .leg-divider {
        border: none;
        border-top: 1px dashed #cde;
        margin: 10px 0;
    }

    .no-bookings {
        color: #aaa;
        font-style: italic;
        padding: 10px 0;
    }

    .status-upcoming {
        background: #d4edda;
        color: #155724;
        border-radius: 20px;
        padding: 2px 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-past {
        background: #e2e3e5;
        color: #555;
        border-radius: 20px;
        padding: 2px 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .passenger-names {
        font-size: 0.8rem;
        color: #555;
        margin-top: 6px;
        font-family: 'Geologica', sans-serif;
    }

    .btn-cancel {
        background: none;
        border: 1px solid #e53e3e;
        color: #e53e3e;
        border-radius: 20px;
        padding: 2px 14px;
        font-size: 0.75rem;
        font-weight: 600;
        font-family: 'Geologica', sans-serif;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #e53e3e;
            color: white;
        }

    .pax-row {
        display: flex;
        gap: 16px;
        align-items: center;
        padding: 4px 0;
        font-size: 0.82rem;
        color: #444;
        font-family: 'Geologica', sans-serif;
    }

    .pax-name {
        font-weight: 600;
        min-width: 140px;
    }

    .pax-seat {
        background: #f0f4f8;
        border-radius: 6px;
        padding: 1px 8px;
        font-size: 0.75rem;
        color: #3c81bd;
        font-weight: 600;
    }

    .pax-section {
        margin-top: 6px;
        padding: 8px 0 4px;
        border-top: 1px solid #eef1f7;
    }

    .btn-see-more {
        background: none;
        border: none;
        color: #3c81bd;
        font-size: 0.78rem;
        font-family: 'Geologica', sans-serif;
        font-weight: 600;
        cursor: pointer;
        padding: 4px 0;
        text-decoration: underline;
        display: block;
        margin-top: 4px;
    }
</style>

<h2 class="bookings-header">My Bookings</h2>

<div class="section-label">Upcoming</div>

@if (!Model.UpcomingBookings.Any())
{
    <p class="no-bookings">No upcoming bookings.</p>
}
else
{
    @foreach (var booking in Model.UpcomingBookings)
    {
        var passengers = booking.Passengers.ToList();
        var uniqueId = $"pax-{booking.BookingId}";

        var legs = booking.Tickets
            .GroupBy(t => t.LegId)
            .OrderBy(g => g.Min(t => t.FlightLeg.DepartureTime))
            .ToList();

        <div class="booking-card">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="booking-id">Booking #@booking.BookingId</span> &nbsp;
                    <span class="status-upcoming">Upcoming</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="total-price">USD @booking.TotalPrice.ToString("N2")</span>
                    <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                        <button type="submit" class="btn-cancel">Cancel</button>
                    </form>
                </div>
            </div>

            @foreach (var legGroup in legs)
            {
                var leg = legGroup.First().FlightLeg;

                <hr class="leg-divider" />
                <div class="flight-row">
                    <span class="flight-number-badge">@leg.Flight.FlightNumber</span>
                    <div class="text-center">
                        <div class="airport-code">@leg.DepartureAirport</div>
                        <div class="airport-name">@leg.DepartureAirportNavigation?.AirportName</div>
                        <div class="flight-time">@leg.DepartureTime.ToString("ddd, dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="flight-arrow">→</div>
                    <div class="text-center">
                        <div class="airport-code">@leg.ArrivalAirport</div>
                        <div class="airport-name">@leg.ArrivalAirportNavigation?.AirportName</div>
                        <div class="flight-time">@leg.ArrivalTime.ToString("ddd, dd MMM yyyy HH:mm")</div>
                    </div>
                    <span class="badge-class">@legGroup.First().TicketClass</span>
                </div>

                <div class="pax-section">
                    @for (int i = 0; i < passengers.Count; i++)
                    {
                        var pax = passengers[i];
                        var paxTicket = legGroup.FirstOrDefault(t => t.PassengerId == pax.PassengerId);
                        <div class="pax-row @(i > 0 ? $"d-none pax-extra-{uniqueId}" : "")">
                            <span class="pax-name">@pax.FirstName @pax.LastName</span>
                            <span class="pax-seat">Seat @(paxTicket?.Seat?.SeatNumber ?? "—")</span>
                        </div>
                    }
                    @if (passengers.Count > 1)
                    {
                        <button class="btn-see-more" onclick="togglePax('@uniqueId', this)">
                            See @(passengers.Count - 1) more traveler@(passengers.Count - 1 > 1 ? "s" : "")
                        </button>
                    }
                </div>
            }

            <div class="booking-meta">
                Booked on @booking.BookingDate.ToString("dd MMM yyyy") &nbsp;|&nbsp;
                @booking.Passengers.Count passenger(s)
            </div>
        </div>
    }
}

<div class="section-label">Past</div>

@if (!Model.PastBookings.Any())
{
    <p class="no-bookings">No past bookings.</p>
}
else
{
    @foreach (var booking in Model.PastBookings)
    {
        var passengers = booking.Passengers.ToList();
        var uniqueId = $"pax-past-{booking.BookingId}";

        var legs = booking.Tickets
            .GroupBy(t => t.LegId)
            .OrderBy(g => g.Min(t => t.FlightLeg.DepartureTime))
            .ToList();

        <div class="booking-card past">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="booking-id">Booking #@booking.BookingId</span> &nbsp;
                    <span class="status-past">Completed</span>
                </div>
                <span class="total-price">USD @booking.TotalPrice.ToString("N2")</span>
            </div>

            @foreach (var legGroup in legs)
            {
                var leg = legGroup.First().FlightLeg;

                <hr class="leg-divider" />
                <div class="flight-row">
                    <span class="flight-number-badge">@leg.Flight.FlightNumber</span>
                    <div class="text-center">
                        <div class="airport-code">@leg.DepartureAirport</div>
                        <div class="airport-name">@leg.DepartureAirportNavigation?.AirportName</div>
                        <div class="flight-time">@leg.DepartureTime.ToString("ddd, dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="flight-arrow">→</div>
                    <div class="text-center">
                        <div class="airport-code">@leg.ArrivalAirport</div>
                        <div class="airport-name">@leg.ArrivalAirportNavigation?.AirportName</div>
                        <div class="flight-time">@leg.ArrivalTime.ToString("ddd, dd MMM yyyy HH:mm")</div>
                    </div>
                    <span class="badge-class">@legGroup.First().TicketClass</span>
                </div>

                <div class="pax-section">
                    @for (int i = 0; i < passengers.Count; i++)
                    {
                        var pax = passengers[i];
                        var paxTicket = legGroup.FirstOrDefault(t => t.PassengerId == pax.PassengerId);
                        <div class="pax-row @(i > 0 ? $"d-none pax-extra-{uniqueId}" : "")">
                            <span class="pax-name">@pax.FirstName @pax.LastName</span>
                            <span class="pax-seat">Seat @(paxTicket?.Seat?.SeatNumber ?? "—")</span>
                        </div>
                    }
                    @if (passengers.Count > 1)
                    {
                        <button class="btn-see-more" onclick="togglePax('@uniqueId', this)">
                            See @(passengers.Count - 1) more traveler@(passengers.Count - 1 > 1 ? "s" : "")
                        </button>
                    }
                </div>
            }

            <div class="booking-meta">
                Booked on @booking.BookingDate.ToString("dd MMM yyyy") &nbsp;|&nbsp;
                @booking.Passengers.Count passenger(s)
            </div>
        </div>
    }
}

<script>
    function togglePax(id, btn) {
        const rows = document.querySelectorAll('.pax-extra-' + id);
        const hidden = rows[0]?.classList.contains('d-none');
        rows.forEach(r => r.classList.toggle('d-none', !hidden));
        const count = rows.length;
        btn.textContent = hidden
            ? 'Hide travelers'
            : 'See ' + count + ' more traveler' + (count > 1 ? 's' : '');
    }
</script>