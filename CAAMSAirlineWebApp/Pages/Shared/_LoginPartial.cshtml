<ul class="navbar-nav align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-white mx-3">Hello, @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
        </li>
        <li class="nav-item">
            @* This is a simple GET link that matches your C# OnGetAsync *@
            <a class="nav-link text-white mx-3" asp-page="/Logout">Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white mx-3" asp-page="/Register">Create Account</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white mx-3" asp-page="/Login">Login</a>
        </li>
    }
</ul>